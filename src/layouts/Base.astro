---
import { ClientRouter } from 'astro:transitions';
import Boton from '../components/Boton.astro';
import { WHATSAPP_ENLACE, WHATSAPP_VISIBLE } from '../config/contacto';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = 'NissiDev: webs y sistemas para negocios del Este de Lima. Prueba la demo de tu rubro y arma tu cotización.',
} = Astro.props;
const tituloCompleto = titulo === 'NissiDev' ? titulo : `${titulo} · NissiDev`;

// Las páginas se crean en T21–T23; hasta entonces Servicios, Demos y Contacto dan 404.
const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/demos', texto: 'Demos' },
  { href: '/arma-tu-sistema', texto: 'Arma tu sistema' },
  { href: '/contacto', texto: 'Contacto' },
];
const rutaActual = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f3efe7" />
    <link rel="preload" href="/fonts/manrope-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Si hay JavaScript y no se pidió "movimiento reducido", el titular del hero espera a su animación.
      // Respaldo: si la animación no arranca en 1.5 s (el JavaScript falló o tardó), todo se muestra quieto.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('animar');
        window.__nissidevRespaldo = window.setTimeout(function () {
          document.documentElement.classList.remove('animar');
        }, 1500);
      }
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="logo" href="/" aria-label="NissiDev, ir al inicio">Nissi<span>Dev</span></a>

        <div class="cabecera__acciones">
          <a class="mi-sistema" href="/arma-tu-sistema" data-mi-sistema hidden>
            Mi sistema (<span data-mi-sistema-cantidad></span>)
          </a>
          <button
            class="menu-boton"
            type="button"
            aria-expanded="false"
            aria-controls="menu-principal"
            aria-label="Menú"
            hidden
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path class="menu-boton__abrir" d="M4 8h16M4 16h16"></path>
              <path class="menu-boton__cerrar" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>

        <nav id="menu-principal" class="menu" aria-label="Principal">
          <ul>
            {
              enlaces.map(({ href, texto }) => (
                <li>
                  <a href={href} aria-current={rutaActual === href ? 'page' : undefined}>
                    {texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="pie zona-oscura">
      <div class="contenedor pie__fila">
        <h2 class="pie__titulo">¿Lo conversamos?</h2>
        <Boton href={WHATSAPP_ENLACE} variante="dorado" externo>WhatsApp {WHATSAPP_VISIBLE}</Boton>
        <p class="pie__nota">NissiDev · Webs y sistemas para negocios del Este de Lima</p>
        <p class="pie__nota">© {new Date().getFullYear()} NissiDev · Lima, Perú</p>
      </div>
    </footer>

    <script>
      // Menú móvil: sin JavaScript el menú queda siempre visible.
      // Con View Transitions el header es nuevo en cada página: se conecta en cada astro:page-load.
      const movil = window.matchMedia('(max-width: 47.99rem)');

      const elementosMenu = () => {
        const cabecera = document.querySelector<HTMLElement>('.cabecera');
        const boton = document.querySelector<HTMLButtonElement>('.menu-boton');
        const menu = document.getElementById('menu-principal');
        return cabecera && boton && menu ? { cabecera, boton, menu } : null;
      };

      const abrir = (abierto: boolean) => {
        const actuales = elementosMenu();
        if (!actuales) return;
        actuales.boton.setAttribute('aria-expanded', String(abierto));
        actuales.cabecera.dataset.menu = abierto ? 'abierto' : 'cerrado';
      };

      document.addEventListener('astro:page-load', () => {
        const actuales = elementosMenu();
        if (!actuales) return;
        const { boton, menu } = actuales;
        boton.hidden = false;
        abrir(false);
        boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));
        menu.addEventListener('click', (evento) => {
          if (movil.matches && (evento.target as HTMLElement).closest('a')) abrir(false);
        });
      });

      // Estos dos escuchan siempre al header actual, así que se registran una sola vez.
      document.addEventListener('keydown', (evento) => {
        const actuales = elementosMenu();
        if (evento.key === 'Escape' && actuales?.boton.getAttribute('aria-expanded') === 'true') {
          abrir(false);
          actuales.boton.focus();
        }
      });
      movil.addEventListener('change', () => abrir(false));
    </script>

    <script>
      // Acceso "Mi sistema (n)" en el header: solo aparece si hay módulos elegidos. Sin React.
      import { $carrito } from '../carrito/store';

      const pintar = ({ items }: { items: unknown[] }) => {
        const enlace = document.querySelector<HTMLElement>('[data-mi-sistema]');
        const cantidad = document.querySelector<HTMLElement>('[data-mi-sistema-cantidad]');
        if (!enlace || !cantidad) return;
        enlace.hidden = items.length === 0;
        cantidad.textContent = String(items.length);
        enlace.setAttribute(
          'aria-label',
          `Mi sistema: ${items.length} ${items.length === 1 ? 'módulo elegido' : 'módulos elegidos'}`,
        );
      };

      $carrito.subscribe(pintar);
      document.addEventListener('astro:page-load', () => pintar($carrito.get()));
    </script>

    <script>
      import '../animacion/movimiento';
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    top: var(--espacio-2);
    left: var(--espacio-2);
    z-index: 10;
    padding: var(--espacio-2) var(--espacio-4);
    background: var(--fondo-oscuro);
    color: var(--texto-sobre-oscuro);
    border-radius: var(--radio-pildora);
    transform: translateY(-200%);
  }

  .saltar:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .cabecera__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-2) var(--espacio-4);
    min-height: 4.75rem;
  }

  .logo {
    font-size: 1.3125rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .logo span {
    color: var(--acento-texto);
  }

  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
  }

  .mi-sistema {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--espacio-4);
    background: var(--fondo-elevado);
    border-radius: var(--radio-pildora);
    box-shadow: var(--borde-sutil);
    font-size: var(--texto-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .mi-sistema[hidden] {
    display: none;
  }

  .menu-boton {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: var(--fondo-oscuro);
    color: var(--texto-sobre-oscuro);
    border: 0;
    border-radius: var(--radio-pildora);
    cursor: pointer;
  }

  .menu-boton[hidden] {
    display: none;
  }

  .menu-boton__cerrar,
  .menu-boton[aria-expanded='true'] .menu-boton__abrir {
    display: none;
  }

  .menu-boton[aria-expanded='true'] .menu-boton__cerrar {
    display: inline;
  }

  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-6);
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--acento);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  @media (max-width: 47.99rem) {
    .menu {
      flex-basis: 100%;
      padding: var(--espacio-2) var(--espacio-5);
      margin-bottom: var(--espacio-4);
      background: var(--fondo-elevado);
      border-radius: var(--radio-tarjeta);
      box-shadow: var(--sombra-tarjeta);
    }

    .menu ul {
      flex-direction: column;
      gap: 0;
    }

    .menu li + li {
      border-top: 1px solid var(--color-linea);
    }

    .menu a {
      display: flex;
      min-height: 3rem;
      font-size: var(--texto-lg);
    }

    .cabecera[data-menu='cerrado'] .menu {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .menu-boton {
      display: none;
    }

    /* En escritorio: logo | menú | Mi sistema */
    .menu {
      order: 1;
    }

    .cabecera__acciones {
      order: 2;
    }
  }

  .pie {
    margin-top: var(--espacio-14);
    padding-block: var(--espacio-8) var(--espacio-12);
    background: var(--fondo-oscuro);
    color: var(--texto-sobre-oscuro);
  }

  .pie__fila {
    display: grid;
    gap: var(--espacio-3);
    justify-items: stretch;
  }

  @media (min-width: 48rem) {
    .pie__fila {
      justify-items: start;
    }
  }

  .pie__titulo {
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.023em;
  }

  .pie__nota {
    color: var(--nota-sobre-oscuro);
    font-size: var(--texto-sm);
  }
</style>
