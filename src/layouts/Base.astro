---
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import { WHATSAPP_ENLACE, WHATSAPP_VISIBLE } from '../config/contacto';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = 'NissiDev: webs y sistemas para negocios de todo rubro. Prueba la demo de tu rubro y arma tu cotización.',
} = Astro.props;
const tituloCompleto = titulo === 'NissiDev' ? titulo : `${titulo} · NissiDev`;

const enlaces = [
  { href: '/soluciones', texto: 'Soluciones' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/sobre-mi', texto: 'Sobre mí' },
  { href: '/contacto', texto: 'Contacto' },
];
const rutaActual = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f7f4ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // "js": hay JavaScript, así que el menú móvil empieza cerrado (sin JavaScript queda siempre visible).
      // Las clases se ponen antes de dibujar para que no haya salto (CLS). ClientRouter borra los atributos
      // de <html> al cambiar de página, por eso se vuelven a poner en astro:after-swap.
      // "logo-visto": el armado del logo es de una vez por sesión; después aparece con un fundido corto.
      // Si sessionStorage falla (modo privado, bloqueado), no hay clase y el logo se arma normal.
      const LOGO_ARMADO = 'nissidev:logo-armado';
      const marcarClases = function () {
        const raiz = document.documentElement;
        raiz.classList.add('js');
        try {
          if (sessionStorage.getItem(LOGO_ARMADO)) raiz.classList.add('logo-visto');
        } catch {
          // Sin sessionStorage el logo se arma normal.
        }
      };
      marcarClases();
      document.addEventListener('astro:after-swap', marcarClases);
      document.addEventListener('astro:page-load', function () {
        if (!document.querySelector('[data-logo-armado]')) return;
        try {
          sessionStorage.setItem(LOGO_ARMADO, '1');
        } catch {
          // Si no se puede guardar, la próxima visita también lo verá armarse.
        }
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <!-- Luces de la marca detrás del vidrio. transition:persist: no se vuelven a pintar al cambiar de página. -->
    <div class="luces" aria-hidden="true" transition:persist="luces">
      <span class="luz luz--1"></span>
      <span class="luz luz--2"></span>
      <span class="luz luz--3"></span>
      <span class="luz luz--4"></span>
    </div>

    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <!-- Header flotante: una píldora de vidrio (más opaca, porque pasa por encima de otros vidrios al bajar) -->
    <header class="cabecera">
      <div class="cabecera__pildora vidrio vidrio--fuerte">
        <a class="marca" href="/" aria-label="NissiDev, ir al inicio">
          <Logo class="marca__logo" />
          <span>NissiDev</span>
        </a>

        <div class="cabecera__acciones">
          <a class="cotizar" href="/cotizar" data-cotizar aria-current={rutaActual === '/cotizar' ? 'page' : undefined}>
            Cotizar <b class="cotizar__cuenta" data-cotizar-cantidad hidden></b>
          </a>
          <button
            class="menu-boton"
            type="button"
            aria-expanded="false"
            aria-controls="menu-principal"
            aria-label="Menú"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path class="menu-boton__abrir" d="M4 8h16M4 16h16"></path>
              <path class="menu-boton__cerrar" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>

        <nav id="menu-principal" class="menu" aria-label="Principal">
          <ul>
            {
              enlaces.map(({ href, texto }) => (
                <li>
                  <a href={href} aria-current={rutaActual === href ? 'page' : undefined}>
                    {texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <!-- Pie corto (TD2): la acción de contacto grande ya está en la tarjeta de Contacto -->
    <footer class="pie">
      <div class="contenedor pie__fila">
        <p class="pie__marca"><Logo class="pie__logo" />NissiDev</p>
        <a class="pie__whatsapp" href={WHATSAPP_ENLACE} target="_blank" rel="noopener noreferrer">
          WhatsApp {WHATSAPP_VISIBLE}<span class="solo-lector"> (se abre en otra pestaña)</span>
        </a>
        <p class="pie__nota">© {new Date().getFullYear()} NissiDev</p>
      </div>
    </footer>

    <script>
      // Menú móvil: sin JavaScript el menú queda siempre visible.
      // Con View Transitions el header es nuevo en cada página: se conecta en cada astro:page-load.
      const movil = window.matchMedia('(max-width: 53.74rem)');

      const elementosMenu = () => {
        const cabecera = document.querySelector<HTMLElement>('.cabecera');
        const boton = document.querySelector<HTMLButtonElement>('.menu-boton');
        const menu = document.getElementById('menu-principal');
        return cabecera && boton && menu ? { cabecera, boton, menu } : null;
      };

      const abrir = (abierto: boolean) => {
        const actuales = elementosMenu();
        if (!actuales) return;
        actuales.boton.setAttribute('aria-expanded', String(abierto));
        actuales.cabecera.dataset.menu = abierto ? 'abierto' : 'cerrado';
      };

      document.addEventListener('astro:page-load', () => {
        const actuales = elementosMenu();
        if (!actuales) return;
        const { boton, menu } = actuales;
        abrir(false);
        boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));
        menu.addEventListener('click', (evento) => {
          if (movil.matches && (evento.target as HTMLElement).closest('a')) abrir(false);
        });
      });

      // Estos dos escuchan siempre al header actual, así que se registran una sola vez.
      document.addEventListener('keydown', (evento) => {
        const actuales = elementosMenu();
        if (evento.key === 'Escape' && actuales?.boton.getAttribute('aria-expanded') === 'true') {
          abrir(false);
          actuales.boton.focus();
        }
      });
      movil.addEventListener('change', () => abrir(false));
    </script>

    <script>
      // Luces: suben un poco más lento que la página al hacer scroll (parallax), en un rAF por cuadro.
      // Nada se mueve solo; con movimiento reducido se quedan quietas. Tope de 260 px para que no se vayan.
      // Brillo del vidrio: sigue al puntero solo con mouse; se actualiza solo el vidrio que está debajo.
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
      const conMouse = window.matchMedia('(hover: hover) and (pointer: fine)');
      let pendiente = 0;

      const moverLuces = () => {
        pendiente = 0;
        const luces = document.querySelectorAll<HTMLElement>('.luz');
        luces.forEach((luz, i) => {
          const desplazamiento = reducido.matches ? 0 : Math.min(260, window.scrollY * (0.04 + i * 0.03));
          luz.style.transform = `translate3d(0, ${(-desplazamiento).toFixed(1)}px, 0)`;
        });
      };
      const pedirLuces = () => {
        if (!pendiente) pendiente = requestAnimationFrame(moverLuces);
      };
      window.addEventListener('scroll', pedirLuces, { passive: true });
      reducido.addEventListener('change', pedirLuces);
      document.addEventListener('astro:page-load', pedirLuces);

      let brillo = 0;
      document.addEventListener(
        'pointermove',
        (evento) => {
          if (!conMouse.matches || brillo) return;
          brillo = requestAnimationFrame(() => {
            brillo = 0;
            const vidrio = (evento.target as Element).closest<HTMLElement>('.vidrio');
            if (!vidrio) return;
            const caja = vidrio.getBoundingClientRect();
            vidrio.style.setProperty('--mx', `${evento.clientX - caja.left}px`);
            vidrio.style.setProperty('--my', `${evento.clientY - caja.top}px`);
          });
        },
        { passive: true },
      );
    </script>

    <script>
      // [data-armar]: recibe la clase .armada la primera vez que entra en pantalla (ilustraciones del bento,
      // línea del proceso). Las piezas solo se esconden con .js, así que sin JavaScript se ven armadas.
      document.addEventListener('astro:page-load', () => {
        const piezas = document.querySelectorAll('[data-armar]');
        if (!piezas.length) return;
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('armada');
              observador.unobserve(e.target);
            }
          },
          { threshold: 0.25 },
        );
        piezas.forEach((pieza) => observador.observe(pieza));
        document.addEventListener('astro:before-swap', () => observador.disconnect(), { once: true });
      });
    </script>

    <script>
      // Botón "Cotizar (n)" del header: siempre visible; el contador aparece si hay funciones elegidas. Sin React.
      import { $carrito } from '../carrito/store';

      const pintar = ({ items }: { items: unknown[] }) => {
        const enlace = document.querySelector<HTMLElement>('[data-cotizar]');
        const cantidad = document.querySelector<HTMLElement>('[data-cotizar-cantidad]');
        if (!enlace || !cantidad) return;
        cantidad.hidden = items.length === 0;
        cantidad.textContent = String(items.length);
        if (items.length === 0) enlace.removeAttribute('aria-label');
        else
          enlace.setAttribute(
            'aria-label',
            `Cotizar: ${items.length} ${items.length === 1 ? 'función elegida' : 'funciones elegidas'}`,
          );
      };

      $carrito.subscribe(pintar);
      document.addEventListener('astro:page-load', () => pintar($carrito.get()));
    </script>

  </body>
</html>

<style>
  .saltar {
    position: absolute;
    top: var(--espacio-2);
    left: var(--espacio-2);
    z-index: 30; /* encima del header flotante */
    padding: var(--espacio-2) var(--espacio-4);
    background: var(--fondo-oscuro);
    color: var(--texto-sobre-oscuro);
    border-radius: var(--radio-pildora);
    transform: translateY(-200%);
  }

  .saltar:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  /* Píldora flotante y pegada arriba; el contenido pasa por debajo */
  .cabecera {
    position: sticky;
    top: var(--espacio-3);
    z-index: 20;
    width: min(100% - 2 * var(--espacio-3), var(--ancho-max));
    margin: var(--espacio-3) auto 0;
  }

  .cabecera__pildora {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-2);
    padding: var(--espacio-2) var(--espacio-2) var(--espacio-2) var(--espacio-4);
    border-radius: var(--radio-vidrio);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.5625rem;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .marca :global(.marca__logo) {
    width: 1.25rem;
  }

  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
  }

  /* Botón destacado: negro con el contador en dorado (tinta sobre dorado 5.2:1) */
  .cotizar {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    min-height: 2.75rem;
    padding-inline: var(--espacio-4);
    background: var(--fondo-oscuro);
    color: var(--color-blanco);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-sm);
    font-weight: 600;
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    transition: transform var(--duracion-toque) var(--ease-out);
  }

  .cotizar__cuenta {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: var(--espacio-1);
    background: var(--acento);
    color: var(--color-negro);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cotizar:has(.cotizar__cuenta:not([hidden])) {
    padding-right: var(--espacio-2);
  }

  .cotizar:active,
  .menu-boton:active,
  .menu a:active {
    transform: scale(0.97);
  }

  .cotizar__cuenta[hidden] {
    display: none;
  }

  /* Sin JavaScript no hay botón: el menú queda siempre visible. Círculo de 44 px. */
  .menu-boton {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: rgb(255 255 255 / 0.6);
    color: var(--texto);
    border: 0;
    border-radius: var(--radio-pildora);
    box-shadow: var(--borde-sutil);
    cursor: pointer;
    transition: transform var(--duracion-toque) var(--ease-out);
  }

  :global(.js) .menu-boton {
    display: grid;
  }

  .menu-boton__cerrar,
  .menu-boton[aria-expanded='true'] .menu-boton__abrir {
    display: none;
  }

  .menu-boton[aria-expanded='true'] .menu-boton__cerrar {
    display: inline;
  }

  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1);
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    color: var(--tinta-2);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--duracion-fundido) ease,
      transform var(--duracion-toque) var(--ease-out);
  }

  .menu a[aria-current='page'] {
    background: var(--fondo-elevado);
    color: var(--texto);
    font-weight: 600;
    box-shadow: var(--borde-sutil);
  }

  @media (hover: hover) and (pointer: fine) {
    .menu a:hover {
      background: rgb(255 255 255 / 0.7);
      color: var(--texto);
    }

    .cotizar:hover {
      background: #2c2d31;
    }
  }

  @media (max-width: 53.74rem) {
    /* Sin JavaScript: el menú va dentro de la píldora, en su propia fila */
    .menu {
      order: 3;
      flex-basis: 100%;
    }

    /* Con JavaScript: panel blanco SÓLIDO debajo de la píldora (no vidrio sobre vidrio) */
    :global(.js) .menu {
      position: absolute;
      top: calc(100% + var(--espacio-2));
      right: 0;
      left: 0;
      padding: var(--espacio-2);
      background: var(--fondo-elevado);
      border-radius: var(--radio-tarjeta);
      box-shadow: var(--sombra-tarjeta);
      transform-origin: top right;
    }

    :global(.js) .cabecera:not([data-menu='abierto']) .menu {
      display: none;
    }

    /* Se abre desde el botón: escala y fundido cortos, ease-out */
    :global(.js) .cabecera[data-menu='abierto'] .menu {
      animation: menu-entra 180ms var(--ease-out);
    }

    .menu ul {
      flex-direction: column;
      gap: 0;
    }

    .menu li + li {
      border-top: 1px solid var(--color-linea);
    }

    .menu a {
      display: flex;
      min-height: 3rem;
      font-size: var(--texto-md);
      color: var(--texto);
    }

    .menu a[aria-current='page'] {
      box-shadow: none;
      background: var(--fondo);
    }
  }

  @keyframes menu-entra {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .cabecera[data-menu='abierto'] .menu {
      animation: fundido var(--duracion-fundido) ease;
    }
  }

  @media (min-width: 53.75rem) {
    :global(.js) .menu-boton {
      display: none;
    }

    /* En el HTML el menú va después del botón (para el teclado en el celular); en escritorio va al centro */
    .menu {
      order: 1;
    }

    .cabecera__acciones {
      order: 2;
    }
  }

  .pie {
    margin-top: var(--espacio-16);
    padding-block: var(--espacio-8) var(--espacio-12);
  }

  .pie__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-2) var(--espacio-5);
    color: var(--texto-nota);
    font-size: var(--texto-sm);
  }

  .pie__marca {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    color: var(--texto);
    font-weight: 700;
  }

  .pie :global(.pie__logo) {
    width: 1rem;
  }

  .pie__whatsapp {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--texto);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
