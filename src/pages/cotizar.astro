---
import IntroPagina from '../components/IntroPagina.astro';
import Carrito from '../islas/Carrito';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Cotizar"
  descripcion="Elige las funciones que necesita tu negocio y mira cuánto costaría. Precios referenciales."
>
  <section class="contenedor arma">
    <IntroPagina etiqueta="Precios referenciales" titulo="Arma tu sistema.">
      Elige solo lo que tu negocio necesita. Puedes empezar con poco y sumar funciones después.
    </IntroPagina>

    <Carrito client:visible />
  </section>
</Base>

<style>
  .arma {
    display: grid;
    gap: var(--espacio-4);
    padding-top: var(--espacio-5);
  }

</style>
