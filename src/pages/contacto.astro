---
import ContactoTarjeta from '../components/ContactoTarjeta.astro';
import { WHATSAPP_VISIBLE, ZONA } from '../config/contacto';
import Base from '../layouts/Base.astro';
---

<Base titulo="Contacto" descripcion={`Escríbeme por WhatsApp al ${WHATSAPP_VISIBLE}. Trabajo con negocios del ${ZONA}.`}>
  <section class="contenedor contacto-pagina" aria-labelledby="contacto-titulo">
    <ContactoTarjeta nivel={1} id="contacto-titulo" />
  </section>
</Base>

<style>
  .contacto-pagina {
    max-width: 48rem;
    padding-top: var(--espacio-8);
  }
</style>
