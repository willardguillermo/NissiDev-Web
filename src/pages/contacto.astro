---
import ContactoTarjeta from '../components/ContactoTarjeta.astro';
import { WHATSAPP_VISIBLE } from '../config/contacto';
import Base from '../layouts/Base.astro';
---

<Base titulo="Contacto" descripcion={`Escríbeme por WhatsApp al ${WHATSAPP_VISIBLE}. Cuéntame de tu negocio y te muestro cómo sería tu sistema.`}>
  <section class="contenedor contacto-pagina" aria-labelledby="contacto-titulo">
    <ContactoTarjeta nivel={1} id="contacto-titulo" />
  </section>
</Base>

<style>
  .contacto-pagina {
    max-width: 48rem;
    padding-top: var(--espacio-8);
  }
</style>
