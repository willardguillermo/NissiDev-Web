---
import Boton from '../components/Boton.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import Logo from '../components/Logo.astro';
import ServiciosBento from '../components/ServiciosBento.astro';
import { PASOS, TECNOLOGIAS } from '../catalogo-servicios/proceso';
import { SERVICIOS } from '../catalogo-servicios/servicios';
import { WHATSAPP_ENLACE } from '../config/contacto';
import HistoriaDemo from '../components/HistoriaDemo.astro';
import Base from '../layouts/Base.astro';
import { DULCERIA } from '../rubros/dulceria/config';
---

<Base titulo="NissiDev">
  <section class="contenedor hero" aria-labelledby="hero-titulo">
    <!-- El logo se arma en 3D (solo CSS). data-logo-armado: la primera visita de la sesión lo ve completo. -->
    <div class="hero__escena" data-logo-armado>
      <Logo etiqueta="NissiDev" class="hero__logo" />
    </div>
    <p class="hero__etiqueta entra" style="--n: 0">Webs y sistemas · Este de Lima</p>
    <h1 id="hero-titulo" class="hero__titulo entra" style="--n: 1">
      Software que impulsa <span class="hero__acento">tu negocio.</span>
    </h1>
    <p class="hero__bajada entra" style="--n: 2">
      Prueba cómo quedaría el sistema de tu negocio, elige lo que necesitas y recibe la cotización por WhatsApp.
    </p>
    <div class="hero__acciones entra" style="--n: 3">
      <Boton href="/demos">Ver la demo de mi rubro</Boton>
      <Boton href={WHATSAPP_ENLACE} variante="vidrio" externo><IconoWhatsApp />Escríbeme</Boton>
    </div>
    <ul class="hero__servicios entra" style="--n: 4" aria-label="Servicios">
      {SERVICIOS.map((servicio) => <li class="hero__servicio vidrio vidrio--chico">{servicio.nombre}</li>)}
    </ul>
  </section>


  <section id="demo" class="contenedor seccion demo" aria-labelledby="demo-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <p class="etiqueta">Demo en vivo</p>
      <h2 id="demo-titulo" class="titulo-2">Así se vería <span class="acento">tu</span> sistema.</h2>
      <p class="seccion__bajada">Baja despacio: es una dulcería de ejemplo, de principio a fin.</p>
    </div>
    <HistoriaDemo config={DULCERIA} />
    <p class="demo__sello">Demo · datos de ejemplo</p>
    <Boton href="/demos/dulceria/">Abrir la demo completa</Boton>
  </section>

  <section id="servicios" class="contenedor seccion" aria-labelledby="servicios-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <p class="etiqueta">Lo que hago</p>
      <h2 id="servicios-titulo" class="titulo-2">Cuatro formas de <span class="acento">impulsar</span> tu negocio.</h2>
    </div>
    <ServiciosBento />
  </section>

  <section class="contenedor seccion" aria-labelledby="arma-titulo" data-aparecer>
    <div class="arma">
      <p class="etiqueta">Precios referenciales</p>
      <h2 id="arma-titulo" class="titulo-2">Arma tu sistema</h2>
      <span class="linea-dorada" aria-hidden="true"></span>
      <p class="seccion__bajada">
        Elige las funciones que necesita tu negocio y mira cuánto costaría. Puedes empezar con poco y sumar después.
      </p>
      <Boton href="/arma-tu-sistema">Elegir funciones</Boton>
    </div>
  </section>

  <section class="contenedor seccion" aria-labelledby="pasos-titulo" data-aparecer>
    <h2 id="pasos-titulo" class="titulo-2">Cómo trabajamos</h2>
    <ol class="pasos" role="list">
      {
        PASOS.map((paso, i) => (
          <li class="paso">
            <span class="paso__numero" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="paso__titulo">{paso.titulo}</span>
            <span class="paso__texto">{paso.texto}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contenedor seccion" aria-labelledby="stack-titulo" data-aparecer>
    <h2 id="stack-titulo" class="etiqueta">Con qué construyo</h2>
    <ul class="chips" role="list">
      {TECNOLOGIAS.map((tecnologia) => <li class="chip">{tecnologia}</li>)}
    </ul>
  </section>

  <section class="contenedor seccion" data-aparecer>
    <p class="casos">Casos: próximamente.</p>
  </section>
</Base>

<style>
  /* ---------- Hero Ensamble: todo centrado y con aire ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
    padding-block: var(--espacio-12) var(--espacio-8);
    text-align: center;
  }

  .hero__escena {
    display: grid;
    place-items: center;
    width: 7.375rem;
    height: 9.375rem;
    perspective: 900px;
  }

  .hero__escena :global(.hero__logo) {
    width: 7.375rem;
  }

  .hero__etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* 42 px en el celular, hasta 96 px; espaciado negativo que crece con el tamaño */
  .hero__titulo {
    max-width: 13ch;
    font-size: clamp(2.625rem, 11vw, 6rem);
    font-weight: var(--peso-titulo);
    line-height: var(--interlineado-titulo);
    letter-spacing: var(--espaciado-titulo-1);
  }

  .hero__acento {
    color: var(--acento-texto);
  }

  .hero__bajada {
    max-width: 34ch;
    color: var(--texto-suave);
    font-size: clamp(1.0625rem, 4.4vw, 1.25rem);
    line-height: 1.5;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .hero__servicios {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-2);
    max-width: 34rem;
    margin-top: var(--espacio-1);
    padding: 0;
    list-style: none;
  }

  .hero__servicio {
    padding: var(--espacio-2) 0.875rem;
    color: var(--tinta-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--espacio-14) var(--espacio-8);
    }

    .hero__escena,
    .hero__escena :global(.hero__logo) {
      width: 8.75rem;
    }

    .hero__escena {
      height: 11.125rem;
    }
  }

  /* ---------- Armado del logo ----------
     La escena llega inclinada (vista isométrica) y se endereza con --ease-in-out; mientras, las cuatro
     piezas negras llegan a su lugar y la cinta dorada gira y cae. Todo termina en ~1.1 s. */
  @keyframes logo-iso {
    from {
      transform: rotateX(58deg) rotateZ(-38deg) scale(0.82);
    }
  }

  @keyframes logo-pieza {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(var(--giro, 0deg)) scale(0.92);
    }
  }

  .hero__escena :global(.hero__logo) {
    animation: logo-iso 1100ms var(--ease-in-out) both;
  }

  .hero__escena :global(.pz) {
    animation: logo-pieza 640ms var(--ease-out) both;
  }

  .hero__escena :global(.p-tl) {
    --dx: -70px;
    --dy: -60px;
    animation-delay: 40ms;
  }

  .hero__escena :global(.p-bl) {
    --dx: -90px;
    --dy: 40px;
    animation-delay: 100ms;
  }

  .hero__escena :global(.p-tr) {
    --dx: 90px;
    --dy: -40px;
    animation-delay: 160ms;
  }

  .hero__escena :global(.p-br) {
    --dx: 70px;
    --dy: 60px;
    animation-delay: 220ms;
  }

  .hero__escena :global(.p-oro) {
    --dx: 0px;
    --dy: -24px;
    --giro: -62deg;
    animation-duration: 760ms;
    animation-delay: 300ms;
  }

  /* El texto no espera al logo: empieza a los 300 ms, en paralelo, y termina hacia los 1.1 s.
     Es solo CSS, así que se ve aunque el JavaScript falle. */
  .entra {
    animation: sube 640ms var(--ease-out) both;
    animation-delay: calc(var(--inicio-texto, 300ms) + var(--n) * 80ms);
  }

  /* Segunda vez en la sesión: el logo ya armado aparece con un fundido corto y el texto no espera. */
  :global(.logo-visto) .hero {
    --inicio-texto: 0ms;
  }

  :global(.logo-visto) .hero__escena :global(.hero__logo) {
    animation: fundido var(--duracion-fundido) var(--ease-out) both;
  }

  :global(.logo-visto) .hero__escena :global(.pz) {
    animation: none;
  }

  /* Movimiento reducido: sin giros ni desplazamientos; el logo aparece armado y todo entra con un fundido. */
  @media (prefers-reduced-motion: reduce) {
    .hero__escena :global(.hero__logo),
    :global(.logo-visto) .hero__escena :global(.hero__logo) {
      animation: fundido var(--duracion-fundido) ease both;
    }

    .hero__escena :global(.pz) {
      animation: none;
    }

    .entra {
      animation: fundido var(--duracion-fundido) ease both;
      animation-delay: calc(var(--n) * 40ms);
    }
  }

  /* ---------- Resto del Inicio: claro, centrado y con aire ---------- */
  .seccion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-4);
    padding-top: var(--espacio-16);
    text-align: center;
  }

  .seccion__cabeza {
    display: grid;
    gap: var(--espacio-3);
    justify-items: center;
  }

  .seccion__bajada {
    max-width: 36ch;
    color: var(--texto-suave);
  }

  .etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .linea-dorada {
    width: 1.75rem;
    height: 2px;
    background: var(--acento);
    border-radius: 2px;
  }

  .demo {
    scroll-margin-top: var(--espacio-4);
  }

  .acento {
    color: var(--acento-texto);
  }

  .demo__sello {
    color: var(--texto-suave);
    font-size: var(--texto-xs);
  }

  .arma {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-3);
    width: 100%;
    max-width: 30rem;
    padding: var(--espacio-8) var(--espacio-6);
    background: var(--fondo-elevado);
    border-radius: 1.5rem;
    box-shadow: var(--sombra-tarjeta);
  }

  .arma :global(.boton) {
    margin-top: var(--espacio-2);
  }

  .pasos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espacio-3);
    width: 100%;
    max-width: 30rem;
    padding: 0;
    list-style: none;
  }

  .paso {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--espacio-1);
    padding: var(--espacio-5) var(--espacio-3);
    background: var(--fondo-elevado);
    border-radius: var(--radio-tarjeta);
  }

  .paso__numero {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
  }

  .paso__titulo {
    font-weight: var(--peso-titulo);
  }

  .paso__texto {
    color: var(--texto-suave);
    font-size: var(--texto-sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-2);
    max-width: 30rem;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: var(--espacio-2) var(--espacio-4);
    background: var(--fondo-elevado);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-sm);
    font-weight: 600;
  }

  .casos {
    width: 100%;
    max-width: 30rem;
    padding: var(--espacio-5);
    color: var(--texto-suave);
    border: 1px dashed var(--color-punteado);
    border-radius: var(--radio-tarjeta);
    font-size: var(--texto-sm);
  }

  @media (min-width: 48rem) {
    .seccion {
      padding-top: var(--espacio-24);
    }

    .pasos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 56rem;
    }
  }
</style>
