---
import Boton from '../components/Boton.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import Logo from '../components/Logo.astro';
import Proceso from '../components/Proceso.astro';
import { SERVICIOS } from '../catalogo-servicios/servicios';
import { WHATSAPP_ENLACE } from '../config/contacto';
import HistoriaDemo from '../components/HistoriaDemo.astro';
import Base from '../layouts/Base.astro';
import { DULCERIA } from '../rubros/dulceria/config';
import { RUBROS } from '../rubros/rubros';
---

<Base titulo="NissiDev">
  <section class="contenedor hero" aria-labelledby="hero-titulo">
    <!-- El logo se arma en 3D (solo CSS). data-logo-armado: la primera visita de la sesión lo ve completo. -->
    <div class="hero__escena" data-logo-armado>
      <Logo etiqueta="NissiDev" class="hero__logo" />
    </div>
    <p class="hero__etiqueta entra" style="--n: 0">Webs y sistemas para tu negocio</p>
    <h1 id="hero-titulo" class="hero__titulo entra" style="--n: 1">
      Software que impulsa <span class="hero__acento">tu negocio.</span>
    </h1>
    <p class="hero__bajada entra" style="--n: 2">
      Prueba cómo quedaría el sistema de tu negocio, elige lo que necesitas y recibe la cotización por WhatsApp.
    </p>
    <div class="hero__acciones entra" style="--n: 3">
      <Boton href="/soluciones">Ver la demo de mi rubro</Boton>
      <Boton href={WHATSAPP_ENLACE} variante="vidrio" externo><IconoWhatsApp />Escríbeme</Boton>
    </div>
    <ul class="hero__servicios entra" style="--n: 4" aria-label="Servicios">
      {SERVICIOS.map((servicio) => <li class="hero__servicio vidrio vidrio--chico">{servicio.nombre}</li>)}
    </ul>
  </section>


  <section id="demo" class="contenedor seccion demo" aria-labelledby="demo-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <p class="etiqueta">Demo en vivo</p>
      <h2 id="demo-titulo" class="titulo-2">Así se vería <span class="acento">tu</span> sistema.</h2>
      <p class="seccion__bajada">Baja despacio: así funciona, de principio a fin.</p>
    </div>
    <HistoriaDemo config={DULCERIA} />
    <Boton href="/soluciones/dulceria/">Abrir la demo completa</Boton>
  </section>

  <section class="contenedor seccion" aria-labelledby="rubros-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <p class="etiqueta">Soluciones</p>
      <h2 id="rubros-titulo" class="titulo-2">Un sistema para <span class="acento">cada rubro.</span></h2>
    </div>
    <ul class="rubros" role="list">
      {
        RUBROS.map((rubro) => (
          <li data-aparecer>
            <a class="rubro vidrio" href={`/soluciones#${rubro.id}`}>
              <span class="rubro__estado">{rubro.estado === 'activa' ? 'Demo disponible' : 'Próximamente'}</span>
              <b class="rubro__nombre">{rubro.nombre}</b>
              <span class="rubro__resumen">{rubro.resumen}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="contenedor seccion" aria-labelledby="pasos-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <p class="etiqueta">Cómo trabajamos</p>
      <h2 id="pasos-titulo" class="titulo-2">De la idea a tu sistema, <span class="acento">sin sorpresas.</span></h2>
    </div>
    <Proceso corto />
    <a class="seccion__mas" href="/servicios">Ver cómo se crea tu sistema</a>
  </section>

  <section class="contenedor seccion" aria-labelledby="cta-titulo" data-aparecer>
    <div class="cta vidrio">
      <h2 id="cta-titulo" class="titulo-2">Arma tu sistema y recibe <span class="acento">tu cotización.</span></h2>
      <p class="seccion__bajada">Elige las funciones que necesitas. Los precios son referenciales y la cotización te llega lista para WhatsApp.</p>
      <div class="cta__acciones">
        <Boton href="/cotizar">Cotizar mi sistema</Boton>
        <Boton href={WHATSAPP_ENLACE} variante="vidrio" externo><IconoWhatsApp />Escríbeme</Boton>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero Ensamble: todo centrado y con aire ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
    padding-block: var(--espacio-12) var(--espacio-8);
    text-align: center;
  }

  .hero__escena {
    display: grid;
    place-items: center;
    width: 7.375rem;
    height: 9.375rem;
    perspective: 900px;
  }

  .hero__escena :global(.hero__logo) {
    width: 7.375rem;
  }

  .hero__etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* 42 px en el celular, hasta 96 px; espaciado negativo que crece con el tamaño */
  .hero__titulo {
    max-width: 13ch;
    font-size: clamp(2.625rem, 11vw, 6rem);
    font-weight: var(--peso-titulo);
    line-height: var(--interlineado-titulo);
    letter-spacing: var(--espaciado-titulo-1);
  }

  .hero__acento {
    color: var(--acento-texto);
  }

  .hero__bajada {
    max-width: 34ch;
    color: var(--texto-suave);
    font-size: clamp(1.0625rem, 4.4vw, 1.25rem);
    line-height: 1.5;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .hero__servicios {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-2);
    max-width: 34rem;
    margin-top: var(--espacio-1);
    padding: 0;
    list-style: none;
  }

  .hero__servicio {
    padding: var(--espacio-2) 0.875rem;
    color: var(--tinta-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--espacio-14) var(--espacio-8);
    }

    .hero__escena,
    .hero__escena :global(.hero__logo) {
      width: 8.75rem;
    }

    .hero__escena {
      height: 11.125rem;
    }
  }

  /* ---------- Armado del logo ----------
     La escena llega inclinada (vista isométrica) y se endereza con --ease-in-out; mientras, las cuatro
     piezas negras llegan a su lugar y la cinta dorada gira y cae. Todo termina en ~1.1 s. */
  @keyframes logo-iso {
    from {
      transform: rotateX(58deg) rotateZ(-38deg) scale(0.82);
    }
  }

  @keyframes logo-pieza {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(var(--giro, 0deg)) scale(0.92);
    }
  }

  .hero__escena :global(.hero__logo) {
    animation: logo-iso 1100ms var(--ease-in-out) both;
  }

  .hero__escena :global(.pz) {
    animation: logo-pieza 640ms var(--ease-out) both;
  }

  .hero__escena :global(.p-tl) {
    --dx: -70px;
    --dy: -60px;
    animation-delay: 40ms;
  }

  .hero__escena :global(.p-bl) {
    --dx: -90px;
    --dy: 40px;
    animation-delay: 100ms;
  }

  .hero__escena :global(.p-tr) {
    --dx: 90px;
    --dy: -40px;
    animation-delay: 160ms;
  }

  .hero__escena :global(.p-br) {
    --dx: 70px;
    --dy: 60px;
    animation-delay: 220ms;
  }

  .hero__escena :global(.p-oro) {
    --dx: 0px;
    --dy: -24px;
    --giro: -62deg;
    animation-duration: 760ms;
    animation-delay: 300ms;
  }

  /* El texto no espera al logo: empieza a los 300 ms, en paralelo, y termina hacia los 1.1 s.
     Es solo CSS, así que se ve aunque el JavaScript falle. */
  .entra {
    animation: sube 640ms var(--ease-out) both;
    animation-delay: calc(var(--inicio-texto, 300ms) + var(--n) * 80ms);
  }

  /* Segunda vez en la sesión: el logo ya armado aparece con un fundido corto y el texto no espera. */
  :global(.logo-visto) .hero {
    --inicio-texto: 0ms;
  }

  :global(.logo-visto) .hero__escena :global(.hero__logo) {
    animation: fundido var(--duracion-fundido) var(--ease-out) both;
  }

  :global(.logo-visto) .hero__escena :global(.pz) {
    animation: none;
  }

  /* Movimiento reducido: sin giros ni desplazamientos; el logo aparece armado y todo entra con un fundido. */
  @media (prefers-reduced-motion: reduce) {
    .hero__escena :global(.hero__logo),
    :global(.logo-visto) .hero__escena :global(.hero__logo) {
      animation: fundido var(--duracion-fundido) ease both;
    }

    .hero__escena :global(.pz) {
      animation: none;
    }

    .entra {
      animation: fundido var(--duracion-fundido) ease both;
      animation-delay: calc(var(--n) * 40ms);
    }
  }

  /* ---------- Resto del Inicio: claro, centrado y con aire ---------- */
  .seccion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-4);
    padding-top: var(--espacio-16);
    text-align: center;
  }

  .seccion__cabeza {
    display: grid;
    gap: var(--espacio-3);
    justify-items: center;
  }

  .seccion__bajada {
    max-width: 36ch;
    color: var(--texto-suave);
  }

  .etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .demo {
    scroll-margin-top: var(--espacio-4);
  }

  .acento {
    color: var(--acento-texto);
  }

  .rubros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--espacio-3);
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .rubros li {
    display: grid;
  }

  .rubro {
    display: grid;
    align-content: start;
    gap: var(--espacio-2);
    padding: var(--espacio-5);
    color: var(--texto);
    text-align: left;
    text-decoration: none;
    transition: transform var(--duracion-toque) var(--ease-out);
  }

  .rubro:active {
    transform: scale(0.97);
  }

  .rubro__estado {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .rubro__nombre {
    font-size: 1.25rem;
    font-weight: var(--peso-titulo);
    letter-spacing: -0.02em;
  }

  .rubro__resumen {
    color: var(--texto-suave);
    font-size: 0.9375rem;
  }

  .seccion__mas {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--texto);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: var(--espacio-4);
    width: 100%;
    padding: var(--espacio-8) var(--espacio-6);
  }

  .cta__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  @media (min-width: 48rem) {
    .seccion {
      padding-top: var(--espacio-24);
    }

  }
</style>
