---
import Boton from '../../components/Boton.astro';
import IconoWhatsApp from '../../components/IconoWhatsApp.astro';
import IntroPagina from '../../components/IntroPagina.astro';
import { whatsappConMensaje } from '../../config/contacto';
import Base from '../../layouts/Base.astro';
import { enlacePedirDemo, RUBROS } from '../../rubros/rubros';

const enlaceOtroRubro = whatsappConMensaje('Hola, mi rubro no está en la lista. Me gustaría ver cómo sería mi sistema.');
---

<Base titulo="Soluciones" descripcion="Sistemas para dulcerías, restaurantes, salones de belleza, clínicas y negocios por mayor. Prueba la demo de tu rubro o pídela por WhatsApp.">
  <section class="contenedor" aria-labelledby="soluciones-titulo">
    <IntroPagina etiqueta="Soluciones" titulo="Un sistema para tu rubro." id="soluciones-titulo">
      Prueba la demo de tu rubro con un negocio y datos de ejemplo. Si aún no está lista, pídela por WhatsApp.
    </IntroPagina>

    <ul class="rubros" role="list">
      {
        RUBROS.map((rubro) => (
          <li id={rubro.id} class:list={['rubro', rubro.estado === 'activa' ? 'vidrio' : 'rubro--pronto']} data-aparecer>
            <p class="rubro__estado">{rubro.estado === 'activa' ? 'Demo disponible' : 'Próximamente · pídela por WhatsApp'}</p>
            <h2 class="rubro__nombre">{rubro.nombre}</h2>
            <span class="rubro__linea" aria-hidden="true" />
            <p class="rubro__texto">{rubro.descripcion}</p>
            {rubro.estado === 'activa' ? (
              <>
                <p class="rubro__negocio">Negocio de ejemplo: {rubro.negocio}</p>
                <Boton href={rubro.ruta}>
                  Probar la demo<span class="solo-lector"> de {rubro.nombre}</span>
                </Boton>
              </>
            ) : (
              <Boton href={enlacePedirDemo(rubro)} variante="secundario" externo>
                <IconoWhatsApp />
                Pedir la demo<span class="solo-lector"> de {rubro.nombre}</span>
              </Boton>
            )}
          </li>
        ))
      }
    </ul>

    <div class="otro" data-aparecer>
      <h2 class="otro__titulo">¿Tu rubro no está?</h2>
      <p class="otro__texto">Escríbeme y te muestro cómo sería.</p>
      <Boton href={enlaceOtroRubro} variante="secundario" externo>Escríbeme por WhatsApp</Boton>
    </div>
  </section>
</Base>

<style>
  .rubros {
    display: grid;
    gap: var(--espacio-4);
    max-width: 30rem;
    padding: 0;
    margin: var(--espacio-6) auto 0;
    list-style: none;
  }

  .rubro {
    scroll-margin-top: 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-3);
    padding: var(--espacio-8) var(--espacio-6);
    text-align: center;
  }

  /* Próximamente: sin vidrio y con borde punteado, como un espacio reservado; su botón pide la demo.
     La única tarjeta de vidrio es la demo activa. */
  .rubro--pronto {
    border: 1px dashed var(--color-punteado);
    border-radius: var(--radio-vidrio);
  }

  .rubro__estado {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rubro--pronto .rubro__estado {
    color: var(--texto-nota);
  }

  .rubro__nombre {
    font-size: var(--texto-xl);
    font-weight: var(--peso-titulo);
    letter-spacing: -0.02em;
  }

  .rubro__linea {
    width: 1.75rem;
    height: 2px;
    background: var(--acento);
    border-radius: 2px;
  }

  .rubro__texto {
    max-width: 32ch;
    color: var(--texto-suave);
  }

  .rubro__negocio {
    font-size: var(--texto-sm);
    font-weight: 600;
  }

  .rubro :global(.boton) {
    margin-top: var(--espacio-2);
  }

  .otro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-3);
    padding-top: var(--espacio-16);
    text-align: center;
  }

  .otro__titulo {
    font-size: var(--titulo-2);
    font-weight: var(--peso-titulo);
    letter-spacing: var(--espaciado-titulo-2);
  }

  .otro__texto {
    color: var(--texto-suave);
  }

  /* 5 rubros sin huecos: 2 arriba (más anchos, la demo disponible primero) y 3 abajo, sobre 6 columnas */
  @media (min-width: 48rem) {
    .rubros {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      max-width: none;
    }

    .rubro {
      grid-column: span 2;
    }

    .rubro:nth-child(-n + 2) {
      grid-column: span 3;
    }
  }
</style>
