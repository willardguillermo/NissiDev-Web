---
import Carrito from '../islas/Carrito';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Arma tu sistema"
  descripcion="Elige las funciones que necesita tu negocio y mira cuánto costaría. Precios referenciales."
>
  <section class="contenedor arma">
    <header class="arma__intro">
      <h1>Arma tu sistema</h1>
      <p>Elige solo lo que tu negocio necesita. Puedes empezar con poco y sumar funciones después.</p>
      <p class="aviso" role="note">Precios referenciales; la cotización final se confirma por WhatsApp.</p>
    </header>

    <Carrito client:visible />
  </section>
</Base>

<style>
  .arma {
    display: grid;
    gap: var(--espacio-8);
    padding-top: var(--espacio-12);
  }

  .arma__intro {
    display: grid;
    gap: var(--espacio-3);
  }

  h1 {
    font-size: var(--texto-xl);
  }

  .aviso {
    padding: var(--espacio-3) var(--espacio-4);
    border-left: 4px solid var(--acento);
    background: var(--fondo-elevado);
    border-radius: var(--radio-sm);
    font-size: var(--texto-sm);
  }
</style>
