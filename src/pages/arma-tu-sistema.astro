---
import Carrito from '../islas/Carrito';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Arma tu sistema"
  descripcion="Elige las funciones que necesita tu negocio y mira cuánto costaría. Precios referenciales."
>
  <section class="contenedor arma">
    <header class="arma__intro">
      <h1 class="arma__titulo">Arma tu sistema.</h1>
      <p class="arma__bajada">Elige solo lo que tu negocio necesita. Puedes empezar con poco y sumar funciones después.</p>
    </header>

    <Carrito client:visible />
  </section>
</Base>

<style>
  .arma {
    display: grid;
    gap: var(--espacio-4);
    padding-top: var(--espacio-5);
  }

  .arma__intro {
    display: grid;
    gap: var(--espacio-3);
  }

  .arma__titulo {
    font-size: clamp(2.375rem, 1.8rem + 2.4vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.037em;
  }

  .arma__bajada {
    max-width: 36rem;
    color: var(--texto-suave);
    font-size: 0.9375rem;
  }
</style>
