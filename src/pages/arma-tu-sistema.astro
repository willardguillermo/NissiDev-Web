---
import Carrito from '../islas/Carrito';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Arma tu sistema"
  descripcion="Elige las funciones que necesita tu negocio y mira cuánto costaría. Precios referenciales."
>
  <section class="contenedor arma">
    <header class="arma__intro">
      <p class="arma__etiqueta">Precios referenciales</p>
      <h1 class="arma__titulo">Arma tu sistema.</h1>
      <span class="arma__linea" aria-hidden="true"></span>
      <p class="arma__bajada">Elige solo lo que tu negocio necesita. Puedes empezar con poco y sumar funciones después.</p>
    </header>

    <Carrito client:visible />
  </section>
</Base>

<style>
  .arma {
    display: grid;
    gap: var(--espacio-4);
    padding-top: var(--espacio-5);
  }

  /* Cabecera centrada como el Inicio; la lista y el resumen quedan alineados a la izquierda para leerlos */
  .arma__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-3);
    padding-block: var(--espacio-4) var(--espacio-4);
    text-align: center;
  }

  .arma__etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .arma__titulo {
    font-size: clamp(2.25rem, 1.8rem + 2.4vw, 3.5rem);
    font-weight: var(--peso-titulo);
    line-height: var(--interlineado-titulo);
    letter-spacing: -0.035em;
  }

  .arma__linea {
    width: 1.75rem;
    height: 2px;
    background: var(--acento);
    border-radius: 2px;
  }

  .arma__bajada {
    max-width: 36ch;
    color: var(--texto-suave);
  }
</style>
