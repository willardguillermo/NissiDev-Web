---
import Boton from '../components/Boton.astro';
import IntroPagina from '../components/IntroPagina.astro';
import { PASOS, STACK } from '../catalogo-servicios/proceso';
import { SERVICIOS } from '../catalogo-servicios/servicios';
import Base from '../layouts/Base.astro';

const dos = (n: number) => String(n).padStart(2, '0');
---

<Base
  titulo="Servicios"
  descripcion="Páginas web, sistemas a medida, aplicaciones móviles y paneles de administración para negocios del Este de Lima."
>
  <section class="contenedor" aria-labelledby="servicios-titulo">
    <IntroPagina etiqueta="Servicios" titulo="Software que impulsa tu negocio." id="servicios-titulo">
      Cuatro formas de ayudar a tu negocio. Puedes empezar por una y sumar las demás después.
    </IntroPagina>

    <!-- Las tarjetas del rotador del Inicio, pero las cuatro a la vista -->
    <ol class="servicios" role="list">
      {
        SERVICIOS.map((servicio, i) => (
          <li class="servicio" data-aparecer>
            <span class="servicio__numero" aria-hidden="true">
              {dos(i + 1)} / {dos(SERVICIOS.length)}
            </span>
            <h2 class="servicio__nombre">{servicio.nombre}</h2>
            <span class="servicio__linea" aria-hidden="true" />
            <p class="servicio__frase">{servicio.frase}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contenedor seccion" aria-labelledby="proceso-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <h2 id="proceso-titulo" class="titulo-2">Cómo trabajamos</h2>
      <p class="seccion__bajada">De la maqueta al sistema funcionando, sin sorpresas.</p>
    </div>
    <ol class="pasos" role="list">
      {
        PASOS.map((paso, i) => (
          <li class="paso" data-aparecer>
            <span class="paso__numero" aria-hidden="true">
              {dos(i + 1)}
            </span>
            <span class="paso__titulo">{paso.titulo}</span>
            <span class="paso__texto">{paso.texto}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contenedor seccion" aria-labelledby="stack-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <h2 id="stack-titulo" class="titulo-2">Con qué construyo</h2>
      <p class="seccion__bajada">Tecnologías actuales, elegidas para que tu sistema sea rápido y fácil de mantener.</p>
    </div>
    <dl class="stack" data-aparecer>
      {
        STACK.map((grupo) => (
          <div class="stack__grupo">
            <dt class="stack__para">{grupo.para}</dt>
            {grupo.tecnologias.map((tecnologia) => (
              <dd class="chip">{tecnologia}</dd>
            ))}
          </div>
        ))
      }
    </dl>
  </section>

  <section class="contenedor seccion" aria-labelledby="siguiente-titulo" data-aparecer>
    <h2 id="siguiente-titulo" class="titulo-2">¿Empezamos?</h2>
    <div class="acciones">
      <Boton href="/demos">Ver la demo de mi rubro</Boton>
      <Boton href="/arma-tu-sistema" variante="secundario">Arma tu sistema</Boton>
    </div>
  </section>
</Base>

<style>
  .servicios {
    display: grid;
    gap: var(--espacio-4);
    max-width: 30rem;
    padding: 0;
    margin: var(--espacio-6) auto 0;
    list-style: none;
  }

  .servicio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-3);
    padding: var(--espacio-8) var(--espacio-6);
    background: var(--fondo-elevado);
    border-radius: 1.5rem;
    box-shadow: var(--sombra-tarjeta);
    text-align: center;
  }

  .servicio__numero,
  .paso__numero {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
  }

  .servicio__nombre {
    font-size: var(--texto-xl);
    font-weight: var(--peso-titulo);
    letter-spacing: -0.02em;
  }

  .servicio__linea {
    width: 1.75rem;
    height: 2px;
    background: var(--acento);
    border-radius: 2px;
  }

  .servicio__frase {
    max-width: 24ch;
    color: var(--texto-suave);
    font-size: var(--texto-lg);
  }

  .seccion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-4);
    padding-top: var(--espacio-16);
    text-align: center;
  }

  .seccion__cabeza {
    display: grid;
    gap: var(--espacio-3);
    justify-items: center;
  }

  .seccion__bajada {
    max-width: 36ch;
    color: var(--texto-suave);
  }

  .pasos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espacio-3);
    width: 100%;
    max-width: 30rem;
    padding: 0;
    list-style: none;
  }

  .paso {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--espacio-1);
    padding: var(--espacio-5) var(--espacio-3);
    background: var(--fondo-elevado);
    border-radius: var(--radio-tarjeta);
  }

  .paso__titulo {
    font-weight: var(--peso-titulo);
  }

  .paso__texto {
    color: var(--texto-suave);
    font-size: var(--texto-sm);
  }

  .stack {
    display: grid;
    gap: var(--espacio-3);
    width: 100%;
    max-width: 30rem;
  }

  .stack__grupo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-2);
    padding: var(--espacio-4);
    background: var(--fondo-elevado);
    border-radius: var(--radio-tarjeta);
  }

  .stack__para {
    flex-basis: 100%;
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .chip {
    margin: 0;
    padding: var(--espacio-2) var(--espacio-4);
    background: var(--fondo);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-sm);
    font-weight: 600;
  }

  .acciones {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 21.25rem;
  }

  @media (min-width: 48rem) {
    .servicios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 56rem;
    }

    .seccion {
      padding-top: var(--espacio-24);
    }

    .pasos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 56rem;
    }

    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 56rem;
    }

    .acciones {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
  }
</style>
