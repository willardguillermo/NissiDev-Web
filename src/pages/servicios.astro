---
import Boton from '../components/Boton.astro';
import IntroPagina from '../components/IntroPagina.astro';
import Proceso from '../components/Proceso.astro';
import ServiciosBento from '../components/ServiciosBento.astro';
import { MODULOS, obtenerModulo } from '../catalogo-servicios/modulos';
import { textoPrecio } from '../catalogo-servicios/precio';
import { PREGUNTAS } from '../catalogo-servicios/preguntas';
import Base from '../layouts/Base.astro';

// Todo sobre crear el sistema: tipos, funciones, proceso, precios y preguntas. Los textos de cada función y
// sus precios salen de MODULOS (los mismos del carrito y de la cotización).
const necesita = (ids: readonly Parameters<typeof obtenerModulo>[0][]) => ids.map((id) => obtenerModulo(id).nombre).join(', ');
---

<Base
  titulo="Servicios"
  descripcion="Páginas web, sistemas a medida, aplicaciones móviles y paneles de administración: qué hace cada función, cómo trabajamos y precios desde."
>
  <section class="contenedor" aria-labelledby="servicios-titulo">
    <IntroPagina etiqueta="Servicios" titulo="Software que impulsa tu negocio." id="servicios-titulo">
      Cuatro formas de ayudar a tu negocio. Puedes empezar por una y sumar las demás después.
    </IntroPagina>

    <div class="servicios">
      <ServiciosBento nivel={2} />
    </div>
  </section>

  <section class="contenedor seccion" aria-labelledby="funciones-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <h2 id="funciones-titulo" class="titulo-2">Qué hace cada función</h2>
      <p class="seccion__bajada">Tu sistema se arma con estas piezas. Elige solo las que necesitas.</p>
    </div>
    <ul class="funciones" role="list">
      {
        MODULOS.map((modulo) => (
          <li class="funcion vidrio" data-aparecer>
            <h3 class="funcion__nombre">{modulo.nombre}</h3>
            <p class="funcion__texto">{modulo.descripcion}</p>
            {modulo.dependencias.length > 0 && <p class="funcion__nota">Necesita: {necesita(modulo.dependencias)}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="contenedor seccion" aria-labelledby="proceso-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <h2 id="proceso-titulo" class="titulo-2">Cómo trabajamos</h2>
      <p class="seccion__bajada">De la maqueta al sistema funcionando, sin sorpresas.</p>
    </div>
    <Proceso />
  </section>

  <section class="contenedor seccion" aria-labelledby="precios-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <h2 id="precios-titulo" class="titulo-2">Precios desde</h2>
      <p class="seccion__bajada">Precios referenciales; la cotización final se confirma por WhatsApp.</p>
    </div>
    <dl class="precios" data-aparecer>
      {
        MODULOS.map((modulo) => (
          <div class="precios__fila">
            <dt>{modulo.nombre}</dt>
            <dd>{textoPrecio(modulo)}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="contenedor seccion" aria-labelledby="preguntas-titulo">
    <div class="seccion__cabeza" data-aparecer>
      <h2 id="preguntas-titulo" class="titulo-2">Preguntas frecuentes</h2>
    </div>
    <div class="preguntas" data-aparecer>
      {
        PREGUNTAS.map(({ pregunta, respuesta }) => (
          <details class="pregunta">
            <summary>{pregunta}</summary>
            <p>{respuesta}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="contenedor seccion" aria-labelledby="siguiente-titulo" data-aparecer>
    <h2 id="siguiente-titulo" class="titulo-2">¿Empezamos?</h2>
    <p class="seccion__bajada">Elige tus funciones y recibe la cotización al momento.</p>
    <Boton href="/cotizar">Cotizar mi sistema</Boton>
  </section>
</Base>

<style>
  .servicios {
    margin-top: var(--espacio-6);
  }

  .seccion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-4);
    padding-top: var(--espacio-16);
    text-align: center;
  }

  .seccion__cabeza {
    display: grid;
    gap: var(--espacio-3);
    justify-items: center;
  }

  .seccion__bajada {
    max-width: 36ch;
    color: var(--texto-suave);
  }

  .funciones {
    display: grid;
    gap: var(--espacio-3);
    width: 100%;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .funcion {
    display: grid;
    align-content: start;
    gap: var(--espacio-2);
    padding: var(--espacio-5);
  }

  .funcion__nombre {
    font-size: 1.125rem;
    font-weight: var(--peso-titulo);
    letter-spacing: -0.015em;
  }

  .funcion__texto {
    color: var(--texto-suave);
    font-size: 0.9375rem;
  }

  .funcion__nota {
    color: var(--texto-nota);
    font-size: var(--texto-sm);
  }

  /* Precios sobre una capa sólida (las cifras no van sobre vidrio, ADR-003) */
  .precios {
    display: grid;
    width: 100%;
    max-width: 40rem;
    padding: var(--espacio-2) var(--espacio-5);
    background: var(--fondo-elevado);
    border-radius: var(--radio-tarjeta);
    box-shadow: var(--sombra-tarjeta);
    text-align: left;
  }

  .precios__fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espacio-1) var(--espacio-4);
    padding-block: var(--espacio-3);
  }

  .precios__fila + .precios__fila {
    border-top: 1px solid var(--color-linea);
  }

  .precios dt {
    font-weight: 600;
  }

  .precios dd {
    margin: 0;
    color: var(--acento-texto);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .preguntas {
    display: grid;
    gap: var(--espacio-2);
    width: 100%;
    max-width: 40rem;
    text-align: left;
  }

  .pregunta {
    background: var(--fondo-elevado);
    border-radius: var(--radio-tarjeta);
    box-shadow: var(--borde-sutil);
  }

  .pregunta summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-3);
    min-height: 3.25rem;
    padding: var(--espacio-3) var(--espacio-5);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .pregunta summary::-webkit-details-marker {
    display: none;
  }

  /* Signo + que gira a × al abrir: solo transform */
  .pregunta summary::after {
    content: '+';
    flex: none;
    color: var(--acento-texto);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1;
    transition: transform var(--duracion-fundido) var(--ease-out);
  }

  .pregunta[open] summary::after {
    transform: rotate(45deg);
  }

  .pregunta p {
    padding: 0 var(--espacio-5) var(--espacio-5);
    color: var(--texto-suave);
  }

  @media (prefers-reduced-motion: reduce) {
    .pregunta summary::after {
      transition: none;
    }
  }

  @media (min-width: 48rem) {
    .seccion {
      padding-top: var(--espacio-24);
    }

    .funciones {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
  }
</style>
