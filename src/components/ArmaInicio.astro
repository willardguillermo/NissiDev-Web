---
// "Arma tu sistema" en el Inicio: chips que se encienden y un total que cuenta, conectados al MISMO carrito
// (store de nanostores, con sus dependencias, confirmaciones y restauración). Sin React, para que el Inicio
// siga liviano: es un <script> de Astro. El total va sobre una capa negra sólida, no sobre el vidrio.
import { MODULOS } from '../catalogo-servicios/modulos';
---

<div class="armar vidrio" data-armar-inicio>
  <div class="armar__elegir">
    <p class="armar__etiqueta">Arma tu sistema</p>
    <h2 id="armar-titulo" class="armar__titulo">Elige. Mira el precio. <span class="armar__acento">Listo.</span></h2>
    <p class="armar__bajada">
      Toca las funciones que necesitas y mira cuánto costaría. Puedes empezar con poco y sumar después.
    </p>

    <div class="chips" role="group" aria-labelledby="armar-titulo">
      {
        MODULOS.map((modulo) => (
          <button type="button" class="chip" aria-pressed="false" data-modulo={modulo.id}>
            <span class="chip__check" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
            </span>
            {modulo.nombre}
          </button>
        ))
      }
    </div>

    <div class="armar__confirmar" role="group" aria-labelledby="armar-pregunta" data-confirmar hidden>
      <p id="armar-pregunta" data-pregunta></p>
      <div class="armar__botones">
        <button type="button" class="chip chip--accion" data-confirmar-si>Sí, quitar</button>
        <button type="button" class="chip" data-confirmar-no>Cancelar</button>
      </div>
    </div>
    <p class="armar__aviso" role="status" data-aviso></p>
    <a class="armar__detalle" href="/cotizar">Ver qué incluye cada función</a>
  </div>

  <div class="total zona-oscura">
    <small>Inversión inicial</small>
    <b class="total__inicial" data-inicial>Elige funciones</b>
    <span class="total__mensual" data-mensual></span>
    <span class="total__nota">Precios referenciales; la cotización final se confirma por WhatsApp.</span>
    <a class="total__cotizacion" href="/cotizacion" data-cotizacion hidden>Ver mi cotización</a>
  </div>
</div>

<script>
  import type { ModuloId } from '../catalogo-servicios/modulos';
  import { calcularTotales } from '../carrito/carrito';
  import { $carrito, agregar, quitar } from '../carrito/store';
  import { avisoAgregar, avisoQuitar, preguntaQuitar, textoTotales } from '../carrito/textos';
  import { animarContador } from '../islas/contador';
  import { formatearSoles } from '../ui/formato';

  const reloj = {
    ahora: () => performance.now(),
    pedirCuadro: (paso: (ahora: number) => void) => requestAnimationFrame(paso),
    cancelarCuadro: (id: number) => cancelAnimationFrame(id),
  };
  const desde = (centimos: number) => `Desde ${formatearSoles(centimos)}`;

  function iniciar() {
    const raiz = document.querySelector<HTMLElement>('[data-armar-inicio]');
    if (!raiz) return;
    const chips = [...raiz.querySelectorAll<HTMLButtonElement>('[data-modulo]')];
    const confirmar = raiz.querySelector<HTMLElement>('[data-confirmar]')!;
    const pregunta = raiz.querySelector<HTMLElement>('[data-pregunta]')!;
    const aviso = raiz.querySelector<HTMLElement>('[data-aviso]')!;
    const inicial = raiz.querySelector<HTMLElement>('[data-inicial]')!;
    const mensual = raiz.querySelector<HTMLElement>('[data-mensual]')!;
    const cotizacion = raiz.querySelector<HTMLAnchorElement>('[data-cotizacion]')!;
    const chipDe = (id: ModuloId) => chips.find((c) => c.dataset.modulo === id)!;

    let anterior: number | null = null;
    let cancelarContador = () => {};
    // Confirmación abierta, con el carrito tal como estaba al pedirla (si cambia, se cancela)
    let pendiente: { id: ModuloId; afectados: ModuloId[]; items: readonly ModuloId[] } | null = null;

    const cerrarConfirmacion = (enfocar: boolean) => {
      if (!pendiente) return;
      const id = pendiente.id;
      pendiente = null;
      confirmar.hidden = true;
      if (enfocar) chipDe(id).focus();
    };

    const pintar = ({ items }: { items: readonly ModuloId[] }) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(items.includes(c.dataset.modulo as ModuloId))));
      if (pendiente && pendiente.items !== items) cerrarConfirmacion(confirmar.contains(document.activeElement));

      const totales = calcularTotales({ items: [...items] });
      const textos = textoTotales(totales);
      cancelarContador();
      inicial.textContent = items.length === 0 ? 'Elige funciones' : textos.inicial;
      mensual.textContent = items.length === 0 ? '' : `${textos.mensual}${textos.notaCotizar ? ` · ${textos.notaCotizar}` : ''}`;
      cotizacion.hidden = items.length === 0;
      // El total "cuenta" desde el anterior (no en la primera pintura ni con movimiento reducido)
      if (anterior !== null && inicial.firstChild instanceof Text) {
        cancelarContador = animarContador({
          nodo: inicial.firstChild,
          desde: anterior,
          hasta: totales.inicial,
          formatear: desde,
          menosMovimiento: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
          reloj,
        });
      }
      anterior = totales.inicial;
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const id = chip.dataset.modulo as ModuloId;
        cerrarConfirmacion(false);
        if (!$carrito.get().items.includes(id)) {
          aviso.textContent = avisoAgregar(id, agregar(id));
          return;
        }
        const resultado = quitar(id);
        if (resultado.estado === 'requiere-confirmacion') {
          pendiente = { id, afectados: resultado.afectados, items: $carrito.get().items };
          pregunta.textContent = preguntaQuitar(id, resultado.afectados);
          aviso.textContent = '';
          confirmar.hidden = false;
          raiz.querySelector<HTMLButtonElement>('[data-confirmar-no]')!.focus();
          return;
        }
        aviso.textContent = avisoQuitar(id, resultado);
      }),
    );

    raiz.querySelector('[data-confirmar-si]')!.addEventListener('click', () => {
      if (!pendiente) return;
      const { id, afectados } = pendiente;
      const resultado = quitar(id, { afectadosConfirmados: afectados });
      if (resultado.estado === 'requiere-confirmacion') {
        // Los afectados cambiaron: se vuelve a preguntar con la lista nueva, sin quitar nada
        pendiente = { id, afectados: resultado.afectados, items: $carrito.get().items };
        pregunta.textContent = preguntaQuitar(id, resultado.afectados);
        return;
      }
      cerrarConfirmacion(true);
      aviso.textContent = avisoQuitar(id, resultado);
    });
    raiz.querySelector('[data-confirmar-no]')!.addEventListener('click', () => cerrarConfirmacion(true));
    confirmar.addEventListener('keydown', (e) => e.key === 'Escape' && cerrarConfirmacion(true));

    const dejarDeEscuchar = $carrito.subscribe(pintar);
    document.addEventListener(
      'astro:before-swap',
      () => {
        dejarDeEscuchar();
        cancelarContador();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .armar {
    display: grid;
    gap: 1.125rem;
    width: 100%;
    padding: var(--espacio-6);
    text-align: left;
  }

  @media (min-width: 53.75rem) {
    .armar {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding: 2.25rem;
    }
  }

  .armar__elegir {
    display: grid;
    gap: 0.875rem;
  }

  .armar__etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .armar__titulo {
    font-size: clamp(2rem, 7.6vw, 3.5rem);
    font-weight: var(--peso-titulo);
    letter-spacing: var(--espaciado-titulo-1);
  }

  .armar__acento {
    color: var(--acento-texto);
  }

  .armar__bajada {
    color: var(--texto-suave);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  /* Tinte blanco dentro del vidrio (no otro vidrio). Encendido: tinta con el check en dorado. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    min-height: 2.875rem;
    padding: 0 var(--espacio-4) 0 var(--espacio-3);
    background: rgb(255 255 255 / 0.7);
    color: var(--texto);
    border: 0;
    border-radius: var(--radio-pildora);
    box-shadow: inset 0 0 0 1px rgb(30 31 34 / 0.14);
    font-size: var(--texto-sm);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color var(--duracion-fundido) ease,
      color var(--duracion-fundido) ease,
      box-shadow var(--duracion-fundido) ease,
      transform var(--duracion-toque) var(--ease-out);
  }

  .chip:active {
    transform: scale(0.97);
  }

  .chip__check {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-negro);
    border-radius: var(--radio-pildora);
    box-shadow: inset 0 0 0 1.5px var(--color-contorno);
    transition: background-color var(--duracion-fundido) ease;
  }

  .chip__check svg {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity var(--duracion-toque) var(--ease-out),
      transform var(--duracion-toque) var(--ease-out);
  }

  .chip[aria-pressed='true'],
  .chip--accion {
    background: var(--fondo-oscuro);
    color: var(--color-blanco);
    box-shadow: 0 6px 16px rgb(30 31 34 / 0.2);
  }

  .chip[aria-pressed='true'] .chip__check {
    background: var(--acento);
    box-shadow: none;
  }

  .chip[aria-pressed='true'] .chip__check svg {
    opacity: 1;
    transform: none;
  }

  .chip--accion {
    padding-left: var(--espacio-4);
  }

  .armar__confirmar {
    display: grid;
    gap: var(--espacio-2);
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--fondo-elevado);
    border-radius: var(--radio-md);
    font-size: var(--texto-sm);
  }

  .armar__confirmar[hidden] {
    display: none;
  }

  .armar__botones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  .armar__aviso {
    min-height: 1.25rem;
    color: var(--texto-suave);
    font-size: var(--texto-sm);
  }

  .armar__detalle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--texto-sm);
    font-weight: 600;
  }

  /* Capa sólida para las cifras (nunca sobre vidrio) */
  .total {
    display: grid;
    gap: var(--espacio-1);
    padding: 1.125rem 1.25rem;
    background: var(--fondo-oscuro);
    color: var(--color-blanco);
    border-radius: 1.375rem;
  }

  .total small {
    color: var(--texto-suave-sobre-oscuro);
    font-size: 0.8125rem;
  }

  .total__inicial {
    font-size: clamp(1.875rem, 8vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .total__mensual {
    color: var(--acento-sobre-oscuro);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .total__nota {
    margin-top: var(--espacio-1);
    color: var(--nota-sobre-oscuro);
    font-size: var(--texto-xs);
  }

  /* Dorado sobre negro con texto tinta (5.2:1) */
  .total__cotizacion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    margin-top: var(--espacio-3);
    background: var(--acento);
    color: var(--color-negro);
    border-radius: var(--radio-pildora);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--duracion-toque) var(--ease-out);
  }

  .total__cotizacion[hidden] {
    display: none;
  }

  .total__cotizacion:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .chip,
    .total__cotizacion,
    .chip__check svg {
      transition:
        background-color var(--duracion-fundido) ease,
        color var(--duracion-fundido) ease,
        opacity var(--duracion-fundido) ease;
    }

    .chip__check svg {
      transform: none;
    }
  }
</style>
