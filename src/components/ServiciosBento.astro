---
// Los 4 servicios en bento: tarjetas de vidrio con una mini ilustración que se arma al aparecer en pantalla
// (web, barras, app, gráfico). Textos del video de marca (SERVICIOS). Lo usan el Inicio y /servicios.
// Sin JavaScript las ilustraciones se ven armadas desde el inicio.
import { SERVICIOS } from '../catalogo-servicios/servicios';

interface Props {
  /** Nivel del título de cada tarjeta: h3 bajo un h2 de sección, h2 bajo el h1 de una página. */
  nivel?: 2 | 3;
}

const { nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as const;
const dos = (n: number) => String(n).padStart(2, '0');
const ILUSTRACIONES = ['web', 'barras', 'app', 'grafico'] as const;
---

<ul class="bento" role="list">
  {
    SERVICIOS.map((servicio, i) => (
      <li class:list={['tarjeta', 'vidrio', `tarjeta--${i + 1}`]} data-armar>
        <span class="tarjeta__numero">{dos(i + 1)}</span>
        <div class:list={['ilu', `ilu--${ILUSTRACIONES[i]}`]} aria-hidden="true">
          {ILUSTRACIONES[i] === 'web' && (
            <>
              <span class="ilu-web__barra" />
              {[1, 2, 3, 4, 5].map((k) => (
                <span class={`ilu-web__bloque ilu-web__k${k}`} style={`--i: ${k - 1}`} />
              ))}
            </>
          )}
          {ILUSTRACIONES[i] === 'barras' && [60, 85, 45, 100].map((alto, k) => <i style={`--alto: ${alto}%; --i: ${k}`} />)}
          {ILUSTRACIONES[i] === 'app' && (
            <div class="ilu-app__fono">
              {Array.from({ length: 9 }, (_, k) => (
                <i style={`--i: ${k}`} />
              ))}
            </div>
          )}
          {ILUSTRACIONES[i] === 'grafico' && (
            <svg viewBox="0 0 300 110" preserveAspectRatio="none">
              <path class="ilu-grafico__area" d="M0 95 L50 70 L100 78 L150 45 L200 52 L250 22 L300 30 L300 110 L0 110Z" />
              <path class="ilu-grafico__linea" d="M0 95 L50 70 L100 78 L150 45 L200 52 L250 22 L300 30" />
            </svg>
          )}
        </div>
        <Titulo class="tarjeta__nombre">{servicio.nombre}</Titulo>
        <p class="tarjeta__frase">{servicio.frase}</p>
      </li>
    ))
  }
</ul>

<script>
  // Arma cada ilustración la primera vez que su tarjeta entra en pantalla
  document.addEventListener('astro:page-load', () => {
    const tarjetas = document.querySelectorAll('[data-armar]');
    if (!tarjetas.length) return;
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('armada');
          observador.unobserve(e.target);
        }
      },
      { threshold: 0.25 },
    );
    tarjetas.forEach((t) => observador.observe(t));
    document.addEventListener('astro:before-swap', () => observador.disconnect(), { once: true });
  });
</script>

<style>
  .bento {
    display: grid;
    gap: 0.875rem;
    width: 100%;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  @media (min-width: 47.5rem) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .tarjeta--1,
    .tarjeta--4 {
      grid-column: span 4;
    }

    .tarjeta--2,
    .tarjeta--3 {
      grid-column: span 2;
    }
  }

  .tarjeta {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    padding: 1.375rem;
  }

  .tarjeta__numero {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
  }

  .tarjeta__nombre {
    font-size: clamp(1.625rem, 6vw, 2.125rem);
    font-weight: var(--peso-titulo);
    letter-spacing: var(--espaciado-titulo-2);
  }

  .tarjeta__frase {
    color: var(--texto-suave);
  }

  /* Un tinte blanco dentro del vidrio (no otro vidrio: sin backdrop-filter) */
  .ilu {
    position: relative;
    height: 9.375rem;
    overflow: hidden;
    background: rgb(255 255 255 / 0.55);
    border-radius: 1.25rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8);
  }

  /* Estado "sin armar": solo con JavaScript (sin él, todo se ve armado) */
  :global(.js) .tarjeta:not(.armada) .ilu-web__bloque,
  :global(.js) .tarjeta:not(.armada) .ilu-app__fono i {
    opacity: 0;
  }

  .armada .ilu-web__bloque,
  .armada .ilu-app__fono i {
    animation: arma 520ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  @keyframes arma {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.92);
    }
  }

  /* 01 web: la página se arma */
  .ilu-web__barra,
  .ilu-web__bloque {
    position: absolute;
    border-radius: 0.625rem;
  }

  .ilu-web__barra {
    top: 0.75rem;
    right: 0.75rem;
    left: 0.75rem;
    height: 0.875rem;
    background: rgb(30 31 34 / 0.08);
    border-radius: 0.4375rem;
  }

  .ilu-web__k1 {
    top: 2.25rem;
    left: 0.75rem;
    width: 58%;
    height: 1.375rem;
    background: var(--fondo-oscuro);
  }

  .ilu-web__k2 {
    top: 4rem;
    left: 0.75rem;
    width: 40%;
    height: 0.625rem;
    background: var(--acento);
  }

  .ilu-web__k3,
  .ilu-web__k4,
  .ilu-web__k5 {
    top: 5.375rem;
    width: 28%;
    height: 3.125rem;
    background: #e9e3d6;
  }

  .ilu-web__k3 {
    left: 0.75rem;
  }

  .ilu-web__k4 {
    left: 36%;
  }

  .ilu-web__k5 {
    left: calc(100% - 28% - 0.75rem);
  }

  /* 02 sistema: las barras del stock suben */
  .ilu--barras {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.625rem;
    padding: 1.125rem;
  }

  .ilu--barras i {
    width: 1.625rem;
    height: var(--alto);
    background: var(--fondo-oscuro);
    border-radius: 0.5rem 0.5rem 0.25rem 0.25rem;
    transform-origin: bottom;
  }

  .ilu--barras i:nth-child(2n) {
    background: var(--acento);
  }

  :global(.js) .tarjeta:not(.armada) .ilu--barras i {
    transform: scaleY(0.08);
  }

  .armada .ilu--barras i {
    animation: sube-barra 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  @keyframes sube-barra {
    from {
      transform: scaleY(0.08);
    }
  }

  /* 03 app: los íconos aparecen en la pantalla */
  .ilu--app {
    display: grid;
    place-items: center;
  }

  .ilu-app__fono {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-content: start;
    gap: 0.375rem;
    width: 5.25rem;
    height: 8.125rem;
    padding: 0.625rem 0.5rem;
    background: var(--fondo-oscuro);
    border-radius: 1.25rem;
  }

  .ilu-app__fono i {
    aspect-ratio: 1;
    background: #3a3b40;
    border-radius: 0.375rem;
  }

  .ilu-app__fono i:nth-child(3n + 1) {
    background: var(--acento);
  }

  /* 04 panel: el gráfico se extiende de izquierda a derecha (transform) y el área aparece */
  .ilu--grafico svg {
    position: absolute;
    inset: 1rem;
    width: calc(100% - 2rem);
    height: calc(100% - 2rem);
    transform-origin: left;
  }

  .ilu-grafico__linea {
    fill: none;
    stroke: var(--fondo-oscuro);
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .ilu-grafico__area {
    fill: rgb(178 138 76 / 0.25);
  }

  :global(.js) .tarjeta:not(.armada) .ilu--grafico svg {
    transform: scaleX(0.05);
  }

  :global(.js) .tarjeta:not(.armada) .ilu-grafico__area {
    opacity: 0;
  }

  .armada .ilu--grafico svg {
    animation: extiende 1100ms var(--ease-in-out) both;
  }

  .armada .ilu-grafico__area {
    animation: fundido 600ms ease 700ms both;
  }

  @keyframes extiende {
    from {
      transform: scaleX(0.05);
    }
  }

  /* Movimiento reducido: todo se arma con un fundido corto, sin subir ni crecer ni dibujarse */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .tarjeta:not(.armada) .ilu--barras i {
      transform: none;
      opacity: 0;
    }

    :global(.js) .tarjeta:not(.armada) .ilu--grafico svg {
      transform: none;
      opacity: 0;
    }

    .armada .ilu-web__bloque,
    .armada .ilu-app__fono i,
    .armada .ilu--barras i,
    .armada .ilu--grafico svg,
    .armada .ilu-grafico__area {
      animation: fundido var(--duracion-fundido) ease both;
    }
  }
</style>
