---
// "Momento A": la N de NissiDev en 3D con CSS (dos laterales oscuras y la diagonal dorada).
// Decorativa (aria-hidden). Gira con el scroll y, en escritorio, con el puntero (ver el <script>).
// 📌 Lugar reservado para una escena de Spline futura (docs/diseño.md): si llega, reemplaza solo
//    este componente y esta versión CSS queda como respaldo y para "movimiento reducido".
const piezas = ['izquierda', 'diagonal', 'derecha'];
---

<div class="n3d" aria-hidden="true" data-n3d>
  <div class="n3d__scroll" data-n3d-scroll>
    <div class="n3d__puntero" data-n3d-puntero>
      {
        piezas.map((pieza) => (
          <div class:list={['n3d__pieza', `n3d__pieza--${pieza}`]}>
            <span class="n3d__cara n3d__cara--frente" />
            <span class="n3d__cara n3d__cara--lado-izq" />
            <span class="n3d__cara n3d__cara--lado-der" />
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { alIniciarPagina } from '../animacion/movimiento';

  alIniciarPagina(() => {
    const giro = document.querySelector<HTMLElement>('[data-n3d-scroll]');
    const puntero = document.querySelector<HTMLElement>('[data-n3d-puntero]');
    const zona = document.querySelector<HTMLElement>('[data-n3d]');
    if (!giro || !puntero || !zona) return;

    // Gira suave mientras la sección cruza la pantalla.
    gsap.fromTo(
      giro,
      { rotationY: -32, rotationX: 10 },
      {
        rotationY: 28,
        rotationX: -6,
        ease: 'none',
        scrollTrigger: { trigger: zona, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
      },
    );

    // En escritorio con mouse, además se inclina hacia el puntero.
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const haciaX = gsap.quickTo(puntero, 'rotationY', { duration: 0.6, ease: 'power3.out' });
    const haciaY = gsap.quickTo(puntero, 'rotationX', { duration: 0.6, ease: 'power3.out' });
    const mover = (evento: PointerEvent) => {
      const caja = zona.getBoundingClientRect();
      const x = (evento.clientX - caja.left) / caja.width - 0.5;
      const y = (evento.clientY - caja.top) / caja.height - 0.5;
      haciaX(x * 24);
      haciaY(-y * 18);
    };
    const soltar = () => {
      haciaX(0);
      haciaY(0);
    };
    zona.addEventListener('pointermove', mover);
    zona.addEventListener('pointerleave', soltar);
    return () => {
      zona.removeEventListener('pointermove', mover);
      zona.removeEventListener('pointerleave', soltar);
    };
  });
</script>

<style>
  /* Medidas en em: toda la N escala con el font-size del contenedor. */
  .n3d {
    --ancho: 11.875em;
    --alto: 13.125em;
    --barra: 2.875em;
    --fondo-3d: 1.5em;
    display: grid;
    place-items: center;
    width: 100%;
    height: 20em;
    font-size: clamp(14px, 3.6vw, 20px);
    perspective: 55em;
  }

  .n3d__scroll,
  .n3d__puntero {
    position: relative;
    width: var(--ancho);
    height: var(--alto);
    transform-style: preserve-3d;
  }

  /* Ángulo de reposo: es lo que se ve con "movimiento reducido". */
  .n3d__scroll {
    transform: rotateY(-20deg) rotateX(8deg);
  }

  .n3d__pieza {
    position: absolute;
    top: 0;
    width: var(--barra);
    height: var(--alto);
    transform-style: preserve-3d;
  }

  .n3d__pieza--izquierda {
    left: 0;
  }

  .n3d__pieza--derecha {
    right: 0;
  }

  /* Diagonal: de arriba a la izquierda a abajo a la derecha. */
  .n3d__pieza--diagonal {
    left: calc(50% - var(--barra) / 2);
    top: -0.75em;
    width: calc(var(--barra) + 0.25em);
    height: calc(var(--alto) + 1.5em);
    transform: rotate(-25deg);
  }

  .n3d__cara {
    position: absolute;
    inset: 0;
    border-radius: 0.6em;
    background: #2c2d32;
    backface-visibility: hidden;
  }

  .n3d__cara--frente {
    transform: translateZ(calc(var(--fondo-3d) / 2));
    box-shadow: inset -0.35em 0 0 #232428;
  }

  .n3d__cara--lado-izq,
  .n3d__cara--lado-der {
    width: var(--fondo-3d);
    background: #17181b;
  }

  /* Cada costado gira 90° sobre su borde y retrocede media profundidad: queda de -fondo/2 a +fondo/2. */
  .n3d__cara--lado-izq {
    left: 0;
    transform-origin: left center;
    transform: translateZ(calc(var(--fondo-3d) / -2)) rotateY(-90deg);
  }

  .n3d__cara--lado-der {
    left: auto;
    right: 0;
    transform-origin: right center;
    transform: translateZ(calc(var(--fondo-3d) / -2)) rotateY(90deg);
  }

  .n3d__pieza--diagonal .n3d__cara--frente {
    background: var(--color-dorado);
    box-shadow:
      inset 0.5em 0 0 #c9a266,
      inset -0.5em 0 0 #8e6c38;
  }

  .n3d__pieza--diagonal .n3d__cara--lado-izq,
  .n3d__pieza--diagonal .n3d__cara--lado-der {
    background: #6f5329;
  }
</style>
