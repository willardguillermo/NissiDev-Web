---
// Dibujos propios (SVG hecho a mano) para las mini pantallas de los rubros sin demo completa. Solo en HTML:
// no engordan la isla de la demo. Si el nombre no es de aquí, dibuja la Ilustracion de la demo (dulcería),
// también como HTML estático. Decorativos: el nombre siempre va en texto al lado.
import { Ilustracion } from '../islas/demo/Ilustracion';

interface Props {
  nombre: string;
  class?: string;
}

const PROPIOS: readonly string[] = [
  'plato',
  'bebida',
  'postre',
  'tijera',
  'peine',
  'esmalte',
  'maletin',
  'diente',
  'reloj',
  'saco',
  'aceite',
  'caja',
];

const { nombre, class: clase } = Astro.props;
const propio = PROPIOS.includes(nombre);
---

{!propio && <Ilustracion nombre={nombre} className={clase} />}
{propio && (<svg class={clase} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  {
    nombre === 'plato' && (
      <>
        <ellipse cx="48" cy="58" rx="36" ry="14" fill="#e8e2d8" />
        <ellipse cx="48" cy="54" rx="28" ry="10" fill="#fff" />
        <path d="M30 52q18-22 36 0z" fill="#c8572c" />
        <circle cx="40" cy="46" r="4" fill="#3f8f3a" />
        <circle cx="54" cy="44" r="3.5" fill="#f2c14e" />
      </>
    )
  }
  {
    nombre === 'bebida' && (
      <>
        <path d="M30 22h36l-5 58H35z" fill="#e9e3f2" />
        <path d="M32 38h32l-3.6 40H35.6z" fill="#6b2a6e" />
        <path d="M58 14l-6 30" stroke="#f06b3f" stroke-width="4" stroke-linecap="round" />
      </>
    )
  }
  {
    nombre === 'postre' && (
      <>
        <ellipse cx="48" cy="72" rx="30" ry="8" fill="#e8e2d8" />
        <path d="M26 66V46q22-20 44 0v20z" fill="#8d4b8f" />
        <path d="M26 46q22-20 44 0" fill="none" stroke="#f7d9a8" stroke-width="5" />
        <circle cx="48" cy="30" r="5" fill="#d9363e" />
      </>
    )
  }
  {
    nombre === 'tijera' && (
      <>
        <path d="M40 54L70 18M56 54L26 18" stroke="#8a8f99" stroke-width="6" stroke-linecap="round" />
        <circle cx="34" cy="68" r="10" fill="none" stroke="#7a3fb8" stroke-width="6" />
        <circle cx="62" cy="68" r="10" fill="none" stroke="#7a3fb8" stroke-width="6" />
      </>
    )
  }
  {
    nombre === 'peine' && (
      <>
        <rect x="18" y="30" width="60" height="14" rx="5" fill="#c49bf2" />
        <path d="M24 44v24M32 44v24M40 44v24M48 44v24M56 44v24M64 44v24M72 44v24" stroke="#7a3fb8" stroke-width="4" stroke-linecap="round" />
      </>
    )
  }
  {
    nombre === 'esmalte' && (
      <>
        <rect x="38" y="14" width="20" height="26" rx="4" fill="#2b2633" />
        <rect x="28" y="38" width="40" height="44" rx="10" fill="#ec5f9a" />
        <rect x="34" y="46" width="8" height="26" rx="4" fill="#fff" opacity="0.5" />
      </>
    )
  }
  {
    nombre === 'maletin' && (
      <>
        <rect x="36" y="20" width="24" height="14" rx="5" fill="none" stroke="#14688a" stroke-width="5" />
        <rect x="16" y="30" width="64" height="48" rx="10" fill="#4fb3d9" />
        <path d="M48 42v24M36 54h24" stroke="#fff" stroke-width="7" stroke-linecap="round" />
      </>
    )
  }
  {
    nombre === 'diente' && (
      <>
        <path d="M28 26q20-12 40 0q8 14-2 34l-5 18q-5 6-8-2l-5-16-5 16q-3 8-8 2l-5-18q-10-20-2-34z" fill="#fff" stroke="#9fd8ec" stroke-width="4" />
      </>
    )
  }
  {
    nombre === 'reloj' && (
      <>
        <circle cx="48" cy="48" r="30" fill="#fff" stroke="#4fb3d9" stroke-width="6" />
        <path d="M48 30v18l12 8" stroke="#14202a" stroke-width="5" stroke-linecap="round" fill="none" />
      </>
    )
  }
  {
    nombre === 'saco' && (
      <>
        <path d="M30 24h36l-4 10q16 14 12 38q-2 10-12 10H34q-10 0-12-10q-4-24 12-38z" fill="#d9b77a" />
        <path d="M32 24h32" stroke="#8a5a00" stroke-width="5" stroke-linecap="round" />
        <rect x="34" y="50" width="28" height="14" rx="3" fill="#fffdf7" />
      </>
    )
  }
  {
    nombre === 'aceite' && (
      <>
        <rect x="42" y="12" width="12" height="10" rx="2" fill="#3f8f3a" />
        <path d="M40 22h16v10q10 6 10 18v26q0 6-6 6H36q-6 0-6-6V50q0-12 10-18z" fill="#f2c14e" />
        <rect x="34" y="52" width="28" height="16" rx="3" fill="#fff" />
      </>
    )
  }
  {
    nombre === 'caja' && (
      <>
        <path d="M18 34l30-14 30 14v36L48 84 18 70z" fill="#c98f4a" />
        <path d="M18 34l30 14 30-14M48 48v36" fill="none" stroke="#8a5a00" stroke-width="3" />
        <path d="M33 27l30 14" stroke="#f4efe2" stroke-width="5" />
      </>
    )
  }
</svg>)}
