---
// Tarjeta grande de contacto (Inicio y /contacto): WhatsApp como acción principal, el número como texto
// seleccionable, la zona y "Copiar número" (portapapeles; si no se puede, deja el número seleccionado).
import Boton from './Boton.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { WHATSAPP_ENLACE, WHATSAPP_VISIBLE, ZONA } from '../config/contacto';

interface Props {
  /** h1 en /contacto (es el título de la página); h2 en el Inicio. */
  nivel?: 1 | 2;
  id: string;
}

const { nivel = 2, id } = Astro.props;
const Titulo = `h${nivel}` as const;
---

<div class="contacto vidrio" data-contacto>
  <p class="contacto__etiqueta">Contacto</p>
  <Titulo id={id} class="contacto__titulo">¿Lo&nbsp;<span class="contacto__acento">conversamos?</span></Titulo>
  <p class="contacto__bajada">Cuéntame de tu negocio y te muestro cómo sería tu sistema.</p>
  <Boton href={WHATSAPP_ENLACE} externo><IconoWhatsApp />Escríbeme por WhatsApp</Boton>
  <p class="contacto__numero" data-numero>{WHATSAPP_VISIBLE}</p>
  <Boton variante="vidrio" class="contacto__copiar">Copiar número</Boton>
  <p class="contacto__estado" role="status" data-estado></p>
  <p class="contacto__zona">Trabajo con negocios del {ZONA}.</p>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const tarjeta = document.querySelector<HTMLElement>('[data-contacto]');
    if (!tarjeta) return;
    const numero = tarjeta.querySelector<HTMLElement>('[data-numero]')!;
    const estado = tarjeta.querySelector<HTMLElement>('[data-estado]')!;
    tarjeta.querySelector('.contacto__copiar')!.addEventListener('click', async () => {
      try {
        // Sin espacios: así se pega bien en el teléfono o en WhatsApp
        await navigator.clipboard.writeText((numero.textContent ?? '').replace(/\s/g, ''));
        estado.textContent = 'Número copiado';
      } catch {
        // Sin portapapeles (navegador antiguo, sin permiso): se deja seleccionado para copiarlo a mano
        const rango = document.createRange();
        rango.selectNodeContents(numero);
        const seleccion = window.getSelection();
        seleccion?.removeAllRanges();
        seleccion?.addRange(rango);
        estado.textContent = 'Número seleccionado: ya puedes copiarlo';
      }
    });
  });
</script>

<style>
  .contacto {
    display: grid;
    justify-items: center;
    gap: 1.125rem;
    width: 100%;
    padding: var(--espacio-8) var(--espacio-6);
    text-align: center;
  }

  .contacto__etiqueta {
    color: var(--acento-texto);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contacto__titulo {
    /* El título inseparable también debe caber dentro del padding a 320 px. */
    font-size: clamp(1.625rem, 8vw, 4.5rem);
    font-weight: var(--peso-titulo);
    letter-spacing: var(--espaciado-titulo-1);
  }

  .contacto__acento {
    color: var(--acento-texto);
  }

  .contacto__bajada {
    max-width: 38ch;
    color: var(--texto-suave);
  }

  /* Texto, no enlace: se puede seleccionar entero de un toque */
  .contacto__numero {
    font-size: clamp(1.375rem, 6vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    user-select: all;
    -webkit-user-select: all;
  }

  .contacto :global(.contacto__copiar) {
    min-height: 2.75rem;
    font-size: var(--texto-sm);
  }

  .contacto__estado {
    min-height: 1.25rem;
    color: var(--acento-texto);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .contacto__zona {
    color: var(--texto-nota);
    font-size: var(--texto-sm);
  }
</style>
