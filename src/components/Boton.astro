---
// Con href es un enlace; sin href, un <button>.
interface Props {
  href?: string;
  /** primario: tinta · secundario: transparente con contorno suave · dorado: para fondos oscuros */
  variante?: 'primario' | 'secundario' | 'dorado';
  type?: 'button' | 'submit';
  externo?: boolean;
  class?: string;
}

const { href, variante = 'primario', type = 'button', externo = false, class: clase } = Astro.props;
const clases = ['boton', `boton--${variante}`, clase];
---

{
  href ? (
    <a
      class:list={clases}
      href={href}
      target={externo ? '_blank' : undefined}
      rel={externo ? 'noopener noreferrer' : undefined}
    >
      <slot />
      {externo && <span class="solo-lector"> (se abre en otra pestaña)</span>}
    </a>
  ) : (
    <button class:list={clases} type={type}>
      <slot />
    </button>
  )
}

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-2);
    min-height: 3rem;
    padding: var(--espacio-3) 1.375rem;
    border: 0;
    border-radius: var(--radio-pildora);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      transform var(--duracion-toque) var(--ease-out),
      background-color var(--duracion-fundido) ease;
  }

  /* Al presionar responde al instante (también en el celular) */
  .boton:active {
    transform: scale(0.97);
  }

  .boton--primario {
    background: var(--fondo-oscuro);
    color: var(--texto-sobre-oscuro);
  }

  /* Transparente con contorno suave, como en el video */
  .boton--secundario {
    background: transparent;
    color: var(--texto);
    box-shadow: inset 0 0 0 1px rgb(30 31 34 / 0.18);
  }

  .boton--dorado {
    background: var(--acento);
    color: var(--color-negro);
  }

  /* Pasar el mouse solo existe con mouse: en el celular se quedaría pegado */
  @media (hover: hover) and (pointer: fine) {
    .boton--primario:hover {
      background: #34353a;
    }

    .boton--secundario:hover {
      background: rgb(30 31 34 / 0.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boton {
      transition: background-color var(--duracion-fundido) ease;
    }
  }
</style>
