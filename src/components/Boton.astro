---
// Con href es un enlace; sin href, un <button>.
interface Props {
  href?: string;
  /** primario: tinta · secundario: transparente con contorno suave · dorado: para fondos oscuros · vidrio: chip de vidrio */
  variante?: 'primario' | 'secundario' | 'dorado' | 'vidrio';
  type?: 'button' | 'submit';
  externo?: boolean;
  class?: string;
}

const { href, variante = 'primario', type = 'button', externo = false, class: clase } = Astro.props;
// El vidrio usa la clase global (blur, borde brillante, brillo con el puntero y sus versiones sólidas)
const clases = ['boton', `boton--${variante}`, variante === 'vidrio' && 'vidrio vidrio--chico', clase];
---

{
  href ? (
    <a
      class:list={clases}
      href={href}
      target={externo ? '_blank' : undefined}
      rel={externo ? 'noopener noreferrer' : undefined}
    >
      <slot />
      {externo && <span class="solo-lector"> (se abre en otra pestaña)</span>}
    </a>
  ) : (
    <button class:list={clases} type={type}>
      <slot />
    </button>
  )
}

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-2);
    min-height: 3.25rem;
    padding: var(--espacio-3) var(--espacio-6);
    border: 0;
    border-radius: var(--radio-pildora);
    font-size: var(--texto-md);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      transform var(--duracion-toque) var(--ease-out),
      background-color var(--duracion-fundido) ease,
      box-shadow var(--duracion-fundido) ease;
  }

  .boton :global(svg) {
    flex-shrink: 0;
  }

  /* Al presionar responde al instante (también en el celular) */
  .boton:active {
    transform: scale(0.97);
  }

  /* Tinta con un brillo arriba y sombra: el botón se lee como una pieza, no como un rectángulo */
  .boton--primario {
    background: var(--fondo-oscuro);
    color: var(--color-blanco);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 8px 20px rgb(30 31 34 / 0.25);
  }

  /* .boton pone border: 0; el vidrio necesita el suyo (y uno visible cuando el vidrio se vuelve sólido) */
  .boton--vidrio {
    color: var(--texto);
    border: 1px solid var(--vidrio-borde);
  }

  @media (prefers-reduced-transparency: reduce) {
    .boton--vidrio {
      border-color: var(--color-contorno);
    }
  }

  @media (prefers-contrast: more) {
    .boton--vidrio {
      border-color: var(--texto);
    }
  }

  /* Transparente con contorno suave, como en el video */
  .boton--secundario {
    background: transparent;
    color: var(--texto);
    box-shadow: inset 0 0 0 1px rgb(30 31 34 / 0.18);
  }

  .boton--dorado {
    background: var(--acento);
    color: var(--color-negro);
  }

  /* Pasar el mouse solo existe con mouse: en el celular se quedaría pegado */
  @media (hover: hover) and (pointer: fine) {
    .boton--primario:hover {
      background: #34353a;
    }

    .boton--secundario:hover {
      background: rgb(30 31 34 / 0.04);
    }

    .boton--vidrio:hover {
      box-shadow:
        inset 0 1px 0 #fff,
        0 14px 34px rgb(30 31 34 / 0.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boton {
      transition:
        background-color var(--duracion-fundido) ease,
        box-shadow var(--duracion-fundido) ease;
    }
  }
</style>
