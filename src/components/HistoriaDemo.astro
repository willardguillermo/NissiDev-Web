---
// Historia del celular con scroll (ADR-004: ningún rubro protagonista). Arriba, un selector de rubro (radios
// nativos: flechas del teclado); debajo, un celular fijo (sticky) que pasa por los 4 pasos generales mientras
// bajas. Al elegir otro rubro cambian el tema y las pantallas con la misma transición. Nada avanza solo.
// Las pantallas salen de rubros/historias.ts; este archivo solo las dibuja. Sin React: los dibujos son HTML.
import Boton from './Boton.astro';
import DibujoRubro from './DibujoRubro.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { variablesDeTema } from '../demo/tema';
import { PASOS_HISTORIA } from '../rubros/historia';
import { HISTORIAS } from '../rubros/historias';
import { enlacePedirDemo, RUBROS } from '../rubros/rubros';

// Empieza en el primer rubro (Dulcería): es el único con demo completa.
const rubros = RUBROS.map((rubro) => ({
  ...rubro,
  pantallas: HISTORIAS[rubro.id],
  estilo: Object.entries(variablesDeTema(HISTORIAS[rubro.id].tema))
    .map(([nombre, valor]) => `${nombre}: ${valor}`)
    .join('; '),
  enlace:
    rubro.estado === 'activa'
      ? rubro.ruta
      : enlacePedirDemo(rubro),
}));
const inicial = rubros[0];
const dos = (n: number) => String(n).padStart(2, '0');
---

<div class="historia" data-historia>
  <!-- El celular queda fijo solo mientras se recorren los pasos; el botón del rubro va después -->
  <div class="historia__recorrido">
    <div class="historia__pegado">
      <fieldset class="historia__rubros">
        <legend class="solo-lector">Elige tu rubro</legend>
        {
          rubros.map((rubro, i) => (
            <label class="historia__rubro">
              <input type="radio" name="historia-rubro" value={rubro.id} checked={i === 0} data-rubro-opcion />
              <span>{rubro.nombre}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="historia__pasos" role="group" aria-label="Pasos de la demo">
        {
          PASOS_HISTORIA.map((paso, i) => (
            <button type="button" class="historia__paso" data-paso={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="historia__numero">{dos(i + 1)}</span>{" "}
              <span class="historia__corto">{paso.corto}</span>
              <span class="historia__nombre">{paso.nombre}</span>
            </button>
          ))
        }
      </div>

      <div class="historia__marco">
        <!-- Imagen ilustrativa: lo que cuenta cada paso va en la leyenda (aria-live) -->
        <div class="fono" data-fono aria-hidden="true">
          <div class="fono__pantalla">
            <span class="fono__isla"></span>
            {
              rubros.map(({ id, estilo, pantallas: { negocio, vitrina, pedido, whatsapp, panel, leyendas } }, r) => (
                <div class="fono__rubro" style={estilo} data-rubro={id} data-leyendas={JSON.stringify(leyendas)}>
                  <div class:list={['vista', { 'vista--activa': r === 0 }]} data-vista="0">
                    <p class="d-anuncio">{vitrina.anuncio}</p>
                    <p class="d-negocio">{negocio}</p>
                    <p class="d-buscar">{vitrina.buscador}</p>
                    <div class="d-hero">
                      {vitrina.titular}
                      <small>{vitrina.bajada}</small>
                    </div>
                    <div class="d-cats">
                      {vitrina.categorias.map((c) => (
                        <div class="d-cat">
                          <DibujoRubro nombre={c.ilustracion} class="d-ilu" />
                          {c.nombre}
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="vista" data-vista="1">
                    <p class="d-negocio">{pedido.titulo}</p>
                    <div class="d-grid">
                      {pedido.items.map((item, i) => (
                        <div class:list={['d-prod', { 'd-prod--toque': i === 1 }]}>
                          <DibujoRubro nombre={item.ilustracion} class="d-ilu" />
                          <b>{item.nombre}</b>
                          <span>{item.detalle}</span>
                          <span class="d-precio">{item.precio}</span>
                          <span class="d-agregar">{pedido.accion}</span>
                        </div>
                      ))}
                    </div>
                    <div class="d-aviso">
                      <span>{pedido.resumen}</span>
                      <span>{pedido.total}</span>
                    </div>
                  </div>

                  <div class="vista" data-vista="2">
                    <p class="d-negocio d-negocio--chat">WhatsApp · {negocio}</p>
                    <div class="d-chat">
                      <p class="d-burbuja">{whatsapp.mensaje.map((linea) => <span>{linea}</span>)}</p>
                      <p class="d-burbuja d-burbuja--resp">{whatsapp.respuesta}</p>
                    </div>
                  </div>

                  <div class="vista" data-vista="3">
                    <p class="d-negocio d-negocio--chat">Panel del dueño</p>
                    <div class="d-kpi">
                      <small>{panel.principal.etiqueta}</small>
                      <b>{panel.principal.valor}</b>
                      <div class="d-barras">
                        {panel.principal.barras.map((b) => (
                          <div>
                            {b.nombre}
                            <span style={`--v: ${b.proporcion}`} />
                          </div>
                        ))}
                      </div>
                    </div>
                    <div class="d-kpi">
                      <small>{panel.secundario.etiqueta}</small>
                      <div class="d-barras">
                        {panel.secundario.barras.map((b) => (
                          <div>
                            {b.nombre}
                            <span style={`--v: ${b.proporcion}`} />
                          </div>
                        ))}
                      </div>
                    </div>
                    {panel.aviso && (
                      <div class="d-kpi">
                        <small>{panel.aviso.etiqueta}</small>
                        <b class="d-vence">{panel.aviso.texto}</b>
                      </div>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <p class="historia__leyenda" aria-live="polite">
        <strong data-leyenda-titulo>{inicial.pantallas.leyendas[0].titulo}</strong>
        <span data-leyenda-texto>{inicial.pantallas.leyendas[0].texto}</span>
      </p>
      <p class="historia__sello">Demo · datos de ejemplo</p>
    </div>

    <!-- Un espacio por paso: al pasar por el centro de la pantalla, el celular cambia -->
    <div class="historia__espacios" aria-hidden="true">
      {PASOS_HISTORIA.map((_, i) => <div data-espacio={i} />)}
    </div>
  </div>

  <!-- Botón del rubro elegido: su demo completa o pedirla por WhatsApp. Sin JavaScript, el del primero. -->
  <div class="historia__cta">
    {
      rubros.map((rubro, r) => (
        <div data-cta={rubro.id} hidden={r !== 0}>
          {rubro.estado === 'activa' ? (
            <Boton href={rubro.enlace}>
              Abrir la demo completa<span class="solo-lector"> de {rubro.nombre}</span>
            </Boton>
          ) : (
            <Boton href={rubro.enlace} externo>
              <IconoWhatsApp />
              Pide la demo de tu rubro<span class="solo-lector">: {rubro.nombre}</span>
            </Boton>
          )}
        </div>
      ))
    }
  </div>
</div>

<script>
  // Cambia la pantalla según el rubro (selector) y el paso (scroll o botón), e inclina el celular según el
  // scroll (y el puntero, solo con mouse). Con movimiento reducido no hay inclinación y el cambio de rubro es
  // directo. Nada avanza solo.
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
  const conMouse = window.matchMedia('(hover: hover) and (pointer: fine)');

  interface Leyenda {
    titulo: string;
    texto: string;
  }

  function iniciar() {
    const historia = document.querySelector<HTMLElement>('[data-historia]');
    if (!historia) return;
    const fono = historia.querySelector<HTMLElement>('[data-fono]')!;
    const grupos = [...historia.querySelectorAll<HTMLElement>('[data-rubro]')];
    const opciones = [...historia.querySelectorAll<HTMLInputElement>('[data-rubro-opcion]')];
    const botones = [...historia.querySelectorAll<HTMLButtonElement>('[data-paso]')];
    const ctas = [...historia.querySelectorAll<HTMLElement>('[data-cta]')];
    const titulo = historia.querySelector<HTMLElement>('[data-leyenda-titulo]')!;
    const texto = historia.querySelector<HTMLElement>('[data-leyenda-texto]')!;
    // El HTML llega con el primer rubro en el paso 0
    let rubro = grupos[0].dataset.rubro!;
    let paso = 0;

    const ir = (nuevoRubro: string, nuevoPaso: number) => {
      if (nuevoRubro === rubro && nuevoPaso === paso) return;
      // Movimiento reducido: el cambio de rubro es directo, sin fundido
      if (nuevoRubro !== rubro && reducido.matches) {
        historia.dataset.directo = '';
        requestAnimationFrame(() => requestAnimationFrame(() => delete historia.dataset.directo));
      }
      rubro = nuevoRubro;
      paso = nuevoPaso;
      for (const grupo of grupos) {
        const activo = grupo.dataset.rubro === rubro;
        grupo.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => {
          v.classList.toggle('vista--activa', activo && Number(v.dataset.vista) === paso);
        });
        if (activo) {
          const leyenda = (JSON.parse(grupo.dataset.leyendas ?? '[]') as Leyenda[])[paso];
          titulo.textContent = leyenda.titulo;
          texto.textContent = leyenda.texto;
        }
      }
      botones.forEach((b, j) => (j === paso ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current')));
      ctas.forEach((c) => (c.hidden = c.dataset.cta !== rubro));
    };

    botones.forEach((b, i) => b.addEventListener('click', () => ir(rubro, i)));
    opciones.forEach((o) => o.addEventListener('change', () => o.checked && ir(o.value, paso)));
    // El navegador puede recordar otro rubro al volver atrás
    const elegido = opciones.find((o) => o.checked);
    if (elegido) ir(elegido.value, paso);

    let observador: IntersectionObserver;
    const observarPasos = () => {
      observador?.disconnect();
      // Los porcentajes de rootMargin usan el ancho: en apaisado vaciarían la zona central.
      const margen = window.innerHeight * 0.45;
      observador = new IntersectionObserver(
        (entradas) =>
          entradas.forEach((e) => e.isIntersecting && ir(rubro, Number((e.target as HTMLElement).dataset.espacio))),
        { rootMargin: `-${margen}px 0px -${margen}px 0px` },
      );
      historia.querySelectorAll('[data-espacio]').forEach((espacio) => observador.observe(espacio));
    };
    observarPasos();
    window.addEventListener('resize', observarPasos);

    // Inclinación: llega inclinado y se endereza mientras la historia entra en pantalla
    let pendiente = 0;
    let px = 0;
    let py = 0;
    const pintar = () => {
      pendiente = 0;
      if (reducido.matches) {
        fono.style.transform = '';
        return;
      }
      const caja = historia.getBoundingClientRect();
      const avance = Math.min(1, Math.max(0, (innerHeight - caja.top) / (innerHeight * 0.9)));
      const rx = 14 * (1 - avance) - py * 6;
      fono.style.transform = `rotateX(${rx.toFixed(2)}deg) rotateY(${(px * 8).toFixed(2)}deg)`;
    };
    const pedir = () => {
      if (!pendiente) pendiente = requestAnimationFrame(pintar);
    };
    const alMover = (e: PointerEvent) => {
      if (!conMouse.matches) return;
      const caja = fono.getBoundingClientRect();
      px = Math.max(-1, Math.min(1, (e.clientX - (caja.left + caja.width / 2)) / 400));
      py = Math.max(-1, Math.min(1, (e.clientY - (caja.top + caja.height / 2)) / 400));
      pedir();
    };
    window.addEventListener('scroll', pedir, { passive: true });
    window.addEventListener('pointermove', alMover, { passive: true });
    reducido.addEventListener('change', pedir);
    pintar();

    // Al irse de la página (View Transitions) se limpia todo
    document.addEventListener(
      'astro:before-swap',
      () => {
        observador.disconnect();
        window.removeEventListener('resize', observarPasos);
        cancelAnimationFrame(pendiente);
        window.removeEventListener('scroll', pedir);
        window.removeEventListener('pointermove', alMover);
        reducido.removeEventListener('change', pedir);
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .historia {
    position: relative;
    width: 100%;
  }

  /* Debajo del header flotante (~4.5 rem) */
  .historia__pegado {
    position: sticky;
    top: 5.25rem;
    display: grid;
    justify-items: center;
    gap: var(--espacio-3);
  }

  /* Selector de rubro: radios nativos con forma de píldora. En el celular, una fila con scroll horizontal
     que llega hasta los bordes de la pantalla. */
  .historia__rubros {
    display: flex;
    gap: 0.375rem;
    min-width: 0;
    max-width: calc(100% + 2 * var(--espacio-4));
    margin: 0 calc(-1 * var(--espacio-4));
    padding: 0.125rem var(--espacio-4);
    overflow-x: auto;
    border: 0;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .historia__rubros::-webkit-scrollbar {
    display: none;
  }

  .historia__rubro {
    position: relative;
    flex: none;
  }

  /* El radio queda encima de la píldora (invisible): se toca y se enfoca de verdad */
  .historia__rubro input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .historia__rubro span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--espacio-4);
    background: rgb(255 255 255 / 0.7);
    color: var(--tinta-2);
    border-radius: var(--radio-pildora);
    box-shadow: inset 0 0 0 1px rgb(30 31 34 / 0.14);
    font-size: var(--texto-sm);
    font-weight: 600;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color var(--duracion-fundido) ease,
      color var(--duracion-fundido) ease,
      transform var(--duracion-toque) var(--ease-out);
  }

  .historia__rubro input:checked + span {
    background: var(--fondo-oscuro);
    color: var(--color-blanco);
    box-shadow: none;
  }

  .historia__rubro input:active + span {
    transform: scale(0.97);
  }

  .historia__rubro input:focus-visible + span {
    outline: 3px solid var(--foco);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .historia__rubro input:not(:checked):hover + span {
      background: #fff;
      color: var(--texto);
    }
  }

  .historia__pasos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
  }

  .historia__sello {
    grid-column: 1 / -1;
    color: var(--texto-suave);
    font-size: var(--texto-xs);
  }

  .historia__paso {
    min-height: 2.75rem;
    padding: 0 var(--espacio-3);
    background: transparent;
    color: var(--tinta-2);
    border: 0;
    border-radius: var(--radio-pildora);
    box-shadow: inset 0 0 0 1px rgb(30 31 34 / 0.14);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color var(--duracion-fundido) ease,
      color var(--duracion-fundido) ease,
      transform var(--duracion-toque) var(--ease-out);
  }

  .historia__paso:active {
    transform: scale(0.97);
  }

  .historia__paso[aria-current='step'] {
    background: var(--fondo-oscuro);
    color: var(--color-blanco);
    box-shadow: none;
  }

  /* En el celular no caben los números ni el nombre entero: solo la palabra corta del paso */
  .historia__numero,
  .historia__nombre {
    display: none;
  }

  /* Sin JavaScript: no hay rubros ni pasos que tocar ni espacios que recorrer; queda el celular con la portada */
  :global(html:not(.js)) .historia__rubros,
  :global(html:not(.js)) .historia__pasos,
  :global(html:not(.js)) .historia__espacios {
    display: none;
  }

  .historia__marco {
    perspective: 1200px;
  }

  /* Reserva el selector, los pasos, la leyenda y el sello: todo el bloque sticky cabe en un celular de
     667 px de alto. En escritorio pasos y leyenda van al costado, así que reserva menos. */
  .fono {
    --reserva: 21rem;
    width: min(15.625rem, 54vw, calc((100svh - var(--reserva)) * 0.486));
    aspect-ratio: 9 / 18.5;
    padding: 0.5625rem;
    background: linear-gradient(160deg, #2a2b30, #121315);
    border-radius: 2.625rem;
    box-shadow:
      inset 0 0 0 1.5px #3b3c42,
      inset 0 2px 0 rgb(255 255 255 / 0.18),
      0 40px 70px rgb(30 31 34 / 0.28),
      0 8px 18px rgb(30 31 34 / 0.18);
    transition: transform 400ms var(--ease-out);
  }

  /* La pantalla escala como una unidad: todo lo de adentro se mide en --u, que vale 1 rem cuando la pantalla
     mide 12 rem (192 px, la del celular de 390 px aprobada) y crece o se achica en proporción. Nada se recorta. */
  .fono__pantalla {
    --u: calc(100cqw / 12);
    container-type: inline-size;
    position: relative;
    height: 100%;
    overflow: hidden;
    background: #fff;
    border-radius: 2.125rem;
    text-align: left;
  }

  /* Reflejo de vidrio sobre la pantalla */
  .fono__pantalla::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.35) 0%, transparent 28%);
    pointer-events: none;
  }

  .fono__isla {
    position: absolute;
    top: calc(0.5 * var(--u));
    left: 50%;
    z-index: 3;
    width: calc(4.375 * var(--u));
    height: calc(1.25 * var(--u));
    margin-left: -2.1875rem;
    background: #0c0d0e;
    border-radius: var(--radio-pildora);
  }

  /* Cada rubro es una capa con su tema; solo se ve la vista activa del rubro elegido */
  .fono__rubro {
    position: absolute;
    inset: 0;
    color: var(--d-texto);
  }

  .vista {
    position: absolute;
    inset: 0;
    background: var(--d-fondo);
    display: flex;
    flex-direction: column;
    gap: calc(0.5 * var(--u));
    padding: calc(2.375 * var(--u)) calc(0.75 * var(--u)) calc(0.75 * var(--u));
    font-size: calc(0.5 * var(--u));
    line-height: 1.35;
    opacity: 0;
    transform: scale(0.97);
    filter: blur(4px);
    transition:
      opacity 260ms var(--ease-out),
      transform 260ms var(--ease-out),
      filter 260ms var(--ease-out);
  }

  .vista--activa {
    z-index: 1;
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* Movimiento reducido al cambiar de rubro: sin fundido (lo pone el script por dos cuadros) */
  [data-directo] .vista {
    transition: none;
  }

  .d-anuncio {
    padding: calc(0.3 * var(--u));
    background: var(--d-marca);
    color: var(--d-sobre-marca);
    border-radius: calc(0.5 * var(--u));
    font-weight: 700;
    text-align: center;
  }

  .d-negocio {
    color: var(--d-marca-texto);
    font-size: calc(0.875 * var(--u));
    font-weight: 800;
    line-height: 1.1;
  }

  .d-negocio--chat {
    color: var(--d-texto);
  }

  .d-buscar {
    padding: calc(0.4 * var(--u)) calc(0.625 * var(--u));
    background: var(--d-fondo-suave);
    color: var(--d-texto-suave);
    border-radius: var(--radio-pildora);
  }

  .d-hero {
    display: grid;
    gap: calc(0.375 * var(--u));
    padding: calc(0.75 * var(--u));
    background: #1a1a1a;
    color: var(--d-amarillo);
    border-radius: calc(0.875 * var(--u));
    font-size: calc(0.875 * var(--u));
    font-weight: 800;
    line-height: 1.1;
  }

  .d-hero small {
    color: #fff;
    font-size: calc(0.5 * var(--u));
    font-weight: 500;
    line-height: 1.35;
  }

  .d-cats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(0.375 * var(--u));
  }

  .d-cat {
    display: grid;
    justify-items: center;
    gap: calc(0.125 * var(--u));
    padding: calc(0.375 * var(--u)) calc(0.125 * var(--u));
    border: 2px solid var(--d-marca);
    border-radius: calc(0.75 * var(--u));
    font-weight: 700;
  }

  .d-cat:nth-child(2) {
    border-color: var(--d-turquesa);
  }

  .d-cat:nth-child(3) {
    border-color: var(--d-amarillo);
  }

  .d-cat :global(.d-ilu) {
    width: calc(1.625 * var(--u));
  }

  .d-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(0.375 * var(--u));
  }

  .d-prod {
    display: grid;
    gap: calc(0.125 * var(--u));
    padding: calc(0.4 * var(--u));
    background: var(--d-fondo-suave);
    border-radius: calc(0.75 * var(--u));
  }

  .d-prod :global(.d-ilu) {
    width: 100%;
    height: calc(2.25 * var(--u));
    background: var(--d-fondo);
    border-radius: calc(0.5 * var(--u));
  }

  .d-prod b {
    overflow: hidden;
    font-size: calc(0.5625 * var(--u));
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .d-precio {
    font-size: calc(0.625 * var(--u));
    font-weight: 800;
  }

  .d-agregar {
    padding: calc(0.2 * var(--u));
    background: var(--d-marca);
    color: var(--d-sobre-marca);
    border-radius: var(--radio-pildora);
    font-weight: 700;
    text-align: center;
  }

  /* El dedo "toca" Agregar al llegar a este paso */
  .vista--activa .d-prod--toque .d-agregar {
    animation: toque 600ms var(--ease-out) 300ms both;
  }

  @keyframes toque {
    30% {
      transform: scale(0.9);
