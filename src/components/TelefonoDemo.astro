---
// Celular hecho con HTML/CSS que muestra la portada de la dulcería de ejemplo.
// Es una imagen decorativa: los lectores de pantalla oyen solo su descripción.
// Los colores de adentro son los de la demo (docs/referencias/demo-dulceria.md), no los de NissiDev.
---

<div class="telefono" role="img" aria-label="Vista previa: portada de Dulcería La Golosa, una dulcería de ejemplo">
  <div class="telefono__pantalla" aria-hidden="true">
    <p class="golosa__anuncio">Precios por mayor · Pedidos por WhatsApp</p>
    <div class="golosa__cuerpo">
      <p class="golosa__nombre">Dulcería La Golosa</p>
      <p class="golosa__buscador">¿Qué dulce buscas?</p>
      <p class="golosa__hero">Todo para tu Halloween</p>
      <div class="golosa__ocasiones">
        <span style="--borde-ocasion: #ec48ae">Cumpleaños</span>
        <span style="--borde-ocasion: #00c2b9">Bolsitas sorpresa</span>
        <span style="--borde-ocasion: #ffc72c">Halloween</span>
        <span style="--borde-ocasion: #ec48ae">Por mayor</span>
      </div>
      <div class="golosa__relleno"></div>
    </div>
  </div>
</div>

<style>
  .telefono {
    width: 14.75rem;
    height: 27.5rem;
    padding: 0.625rem;
    background: var(--color-pantalla);
    border-radius: 2.25rem;
    box-shadow: var(--sombra-telefono);
  }

  .telefono__pantalla {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #ffffff;
    color: #121212;
    border-radius: 1.75rem;
  }

  .golosa__anuncio {
    padding: 0.3rem;
    background: #ec48ae;
    color: #ffffff;
    font-size: 0.5rem;
    font-weight: 700;
    text-align: center;
  }

  .golosa__cuerpo {
    display: grid;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
  }

  .golosa__nombre {
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .golosa__buscador {
    display: flex;
    align-items: center;
    height: 1.5rem;
    padding-left: 0.625rem;
    background: #f3f3f3;
    color: #555555;
    border-radius: 999px;
    font-size: 0.5rem;
  }

  .golosa__hero {
    display: flex;
    align-items: flex-end;
    height: 5.75rem;
    padding: 0.75rem;
    background: #121212;
    color: #ffc72c;
    border-radius: 0.875rem;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .golosa__ocasiones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
  }

  .golosa__ocasiones span {
    height: 3.125rem;
    padding: 0.375rem;
    border: 2px solid var(--borde-ocasion);
    border-radius: 0.75rem;
    font-size: 0.5rem;
    font-weight: 700;
  }

  .golosa__relleno {
    height: 4rem;
    background: #f3f3f3;
    border-radius: 0.75rem;
  }
</style>
