---
// Rotador de los 4 servicios (tarjeta blanca, como el video). Avanza cada 3 s con un botón visible de
// pausa; se pausa con el foco de teclado, al tocar un punto o con la pestaña oculta. Con "movimiento
// reducido" no avanza solo. Sin JavaScript se ven los 4 servicios en lista.
import { SERVICIOS } from '../catalogo-servicios/servicios';

const dos = (n: number) => String(n).padStart(2, '0');
const total = dos(SERVICIOS.length);
---

<section class="rotador" aria-roledescription="carrusel" aria-label="Servicios" data-rotador>
  <div class="rotador__vista" aria-live="off" data-rotador-vista>
    {
      SERVICIOS.map((servicio, i) => (
        <div
          class:list={['rotador__item', { 'rotador__item--activo': i === 0 }]}
          role="group"
          aria-roledescription="servicio"
          aria-label={`${i + 1} de ${SERVICIOS.length}`}
          data-rotador-item
        >
          <span class="rotador__contador">
            {dos(i + 1)} / {total}
          </span>
          <h2 class="rotador__nombre">{servicio.nombre}</h2>
          <span class="rotador__linea" aria-hidden="true" />
          <p class="rotador__frase">{servicio.frase}</p>
        </div>
      ))
    }
  </div>

  <div class="rotador__controles">
    <button type="button" class="rotador__pausa" aria-label="Pausar servicios" data-rotador-pausa>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path class="rotador__icono-pausa" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
        <path class="rotador__icono-reproducir" d="M8 5.5v13a.75.75 0 0 0 1.14.64l10.4-6.5a.75.75 0 0 0 0-1.28l-10.4-6.5A.75.75 0 0 0 8 5.5z"></path>
      </svg>
    </button>
    <div class="rotador__puntos">
      {
        SERVICIOS.map((servicio, i) => (
          <button
            type="button"
            class="rotador__punto"
            aria-label={servicio.nombre}
            aria-current={i === 0 ? 'true' : undefined}
            data-rotador-punto={i}
          >
            <i />
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { crearRotador, INTERVALO_ROTADOR, rotar, type EstadoRotador, type EventoRotador } from '../ui/rotador';

  let limpiar: (() => void) | null = null;

  function iniciar() {
    const raiz = document.querySelector<HTMLElement>('[data-rotador]');
    const vista = raiz?.querySelector<HTMLElement>('[data-rotador-vista]');
    const pausa = raiz?.querySelector<HTMLButtonElement>('[data-rotador-pausa]');
    if (!raiz || !vista || !pausa) return;
    const items = [...raiz.querySelectorAll<HTMLElement>('[data-rotador-item]')];
    const puntos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-rotador-punto]')];
    const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let estado: EstadoRotador = crearRotador(items.length, menosMovimiento);
    let temporizador = 0;
    const salidas = new Map<HTMLElement, number>();
    const control = new AbortController();
    const { signal } = control;

    const pintar = (anterior: EstadoRotador) => {
      if (anterior.actual !== estado.actual) {
        const viejo = items[anterior.actual];
        viejo.classList.remove('rotador__item--activo');
        viejo.classList.add('rotador__item--sale');
        window.clearTimeout(salidas.get(viejo));
        salidas.set(viejo, window.setTimeout(() => viejo.classList.remove('rotador__item--sale'), 220));
        const nuevo = items[estado.actual];
        nuevo.classList.remove('rotador__item--sale');
        nuevo.classList.add('rotador__item--activo');
      }
      items.forEach((item, i) => item.setAttribute('aria-hidden', String(i !== estado.actual)));
      puntos.forEach((punto, i) =>
        i === estado.actual ? punto.setAttribute('aria-current', 'true') : punto.removeAttribute('aria-current'),
      );
      pausa.setAttribute('aria-label', estado.pausado ? 'Reproducir servicios' : 'Pausar servicios');
      raiz.dataset.pausado = String(estado.pausado);
      // Mientras avanza solo no se anuncia cada cambio; pausado, sí (patrón de carrusel de WAI).
      vista.setAttribute('aria-live', estado.pausado ? 'polite' : 'off');
    };

    const programar = () => {
      window.clearInterval(temporizador);
      if (!estado.pausado && !document.hidden) {
        temporizador = window.setInterval(() => enviar({ tipo: 'tic' }), INTERVALO_ROTADOR);
      }
    };

    function enviar(evento: EventoRotador) {
      const anterior = estado;
      estado = rotar(estado, evento);
      if (estado === anterior) return;
      pintar(anterior);
      if (evento.tipo !== 'tic') programar();
    }

    pausa.addEventListener('click', () => enviar({ tipo: 'alternar' }), { signal });
    puntos.forEach((punto, i) => punto.addEventListener('click', () => enviar({ tipo: 'ir', indice: i }), { signal }));
    // Solo el foco de teclado pausa: un clic en el botón de pausa no debe pausar y luego reanudar.
    raiz.addEventListener(
      'focusin',
      (evento) => {
        if ((evento.target as HTMLElement).matches(':focus-visible')) enviar({ tipo: 'pausar' });
      },
      { signal },
    );
    document.addEventListener('visibilitychange', programar, { signal });

    pintar(estado);
    programar();
    limpiar = () => {
      control.abort();
      window.clearInterval(temporizador);
      salidas.forEach((id) => window.clearTimeout(id));
    };
  }

  // Con View Transitions el script corre una sola vez: se inicia en cada página y se limpia antes de cambiar.
  document.addEventListener('astro:page-load', iniciar);
  document.addEventListener('astro:before-swap', () => {
    limpiar?.();
    limpiar = null;
  });
</script>

<style>
  .rotador {
    display: grid;
    gap: var(--espacio-3);
    width: 100%;
    max-width: 26.25rem;
    margin-inline: auto;
    padding: 1.625rem 1.375rem 1rem;
    background: var(--fondo-elevado);
    border-radius: 1.5rem;
    box-shadow: var(--sombra-tarjeta);
    text-align: center;
  }

  /* Sin JavaScript: los 4 servicios uno debajo del otro */
  .rotador__vista {
    display: grid;
    gap: var(--espacio-6);
  }

  .rotador__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espacio-2);
  }

  .rotador__contador {
    color: var(--acento-texto);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
  }

  .rotador__nombre {
    font-size: 1.375rem;
    font-weight: var(--peso-titulo);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .rotador__linea {
    width: 1.75rem;
    height: 2px;
    background: var(--acento);
    border-radius: 2px;
  }

  .rotador__frase {
    color: var(--texto-suave);
    font-size: var(--texto-sm);
  }

  .rotador__controles {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-1);
  }

  /* Con JavaScript: los servicios se apilan en la misma celda (la altura es la del más alto, sin saltos)
     y cambian con fundido + desenfoque leve. Transiciones (no keyframes) para poder interrumpirlas. */
  :global(.js) .rotador__vista {
    grid-template-areas: 'item';
    gap: 0;
  }

  :global(.js) .rotador__item {
    grid-area: item;
    opacity: 0;
    transform: translateY(8px);
    filter: blur(4px);
    pointer-events: none;
    transition:
      opacity 360ms var(--ease-out),
      transform 360ms var(--ease-out),
      filter 360ms var(--ease-out);
  }

  :global(.js) .rotador__item--activo {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  /* El que sale se va más rápido que lo que entra */
  :global(.js) .rotador__item--sale {
    transform: translateY(-6px);
    transition-duration: 200ms;
  }

  :global(.js) .rotador__controles {
    display: flex;
  }

  .rotador__pausa,
  .rotador__punto {
    display: grid;
    place-items: center;
    padding: 0;
    background: transparent;
    color: var(--texto);
    border: 0;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .rotador__pausa {
    width: 2.75rem;
    height: 2.75rem;
    margin-right: var(--espacio-1);
    border-radius: var(--radio-pildora);
    box-shadow: var(--borde-sutil);
    transition: transform var(--duracion-toque) var(--ease-out);
  }

  .rotador__pausa:active {
    transform: scale(0.97);
  }

  .rotador__icono-reproducir,
  [data-pausado='true'] .rotador__icono-pausa {
    display: none;
  }

  [data-pausado='true'] .rotador__icono-reproducir {
    display: inline;
  }

  .rotador__puntos {
    display: flex;
  }

  /* Área táctil de 36 × 44 px; la rayita visible es más pequeña */
  .rotador__punto {
    width: 2.25rem;
    height: 2.75rem;
    border-radius: var(--radio-sm);
  }

  .rotador__punto i {
    display: block;
    width: 1.125rem;
    height: 3px;
    background: rgb(30 31 34 / 0.15);
    border-radius: 3px;
    transition: background-color var(--duracion-fundido) ease;
  }

  .rotador__punto[aria-current='true'] i {
    background: var(--texto);
  }

  /* Movimiento reducido: el cambio es solo un fundido, sin desplazamiento ni desenfoque */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .rotador__item,
    :global(.js) .rotador__item--sale {
      transform: none;
      filter: none;
      transition: opacity var(--duracion-fundido) ease;
    }

    .rotador__pausa {
      transition: none;
    }
  }
</style>
